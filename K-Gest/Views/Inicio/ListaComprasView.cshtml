@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Previsão de Compras";
}

<div class="container-fluid px-4 py-4" style="max-width: 1100px; margin: 0 auto;">

    @* Topo de Navegação *@
    <div class="mb-3">
        <a asp-action="IndexView" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para o Painel
        </a>
    </div>

    @* Cabeçalho de Inteligência *@
    <div class="d-flex justify-content-between align-items-md-center align-items-start flex-column flex-md-row gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-cart-check-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 var-text-color" style="font-size: 24px; letter-spacing: -0.5px;">Sugestão de Compras Semanal</h2>
                <p class="text-muted small m-0 mt-1 sub-text-toggle">Cálculo preditivo inteligente: cruzando histórico de vendas (7 dias) + margem de segurança e validades</p>
            </div>
        </div>

        @* Ações de Exportação *@
        <button onclick="window.print();" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-printer-fill"></i> Imprimir Lista
        </button>
    </div>

    @* Card Principal da Tabela *@
    <div class="card border-0 shadow-premium card-toggle" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-toggle">
                <thead class="thead-toggle" style="border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px;">Insumo</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px; width: 140px;">Estoque Atual</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px; width: 140px;">Ponto Pedido</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px; width: 140px;">Consumo Previsto</th>
                        <th class="pe-4 py-3 text-salmon text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px; width: 200px; background-color: #fff1ed;">Qtd. Sugerida comprar</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted sub-text-toggle">
                                <i class="bi bi-emoji-smile fs-3 text-success d-block mb-2"></i>
                                <span class="fw-medium">Estoque perfeitamente abastecido!</span><br>
                                <small class="text-secondary">Nenhum insumo atingiu o limite crítico ou possui furos de validade para a próxima semana.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (DataRow row in Model.Rows)
                        {
                            var unidade = row["unidadeMed"].ToString().ToUpper();
                            var estoque = Convert.ToDecimal(row["estoqueAtual"]);
                            var ponto = Convert.ToDecimal(row["pontoPedido"]);
                            var demanda = Convert.ToDecimal(row["demandaSemanal"]);
                            var sugerido = Convert.ToDecimal(row["qtdSugerida"]);
                            var vencendoNaSemana = Convert.ToDecimal(row["qtdVencendoSemana"]);

                            // Regra de negócio visual: Se for KG ou L, divide os valores por 1000 na exibição da tela
                            bool precisaDividir = (unidade == "KG" || unidade == "L");
                            decimal fator = precisaDividir ? 1000m : 1m;
                            string formato = (unidade == "UN") ? "N0" : "N2";

                            // Efetua as divisões com base na regra de unidade do banco
                            estoque /= fator;
                            ponto /= fator;
                            demanda /= fator;
                            sugerido /= fator;
                            vencendoNaSemana /= fator;

                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="fw-semibold text-dark fs-6 d-block var-text-color">@row["nomeInsumo"]</span>
                                    @if (vencendoNaSemana > 0)
                                    {
                                        <span class="d-inline-flex align-items-center gap-1 text-warning small fw-medium mt-0.5" style="font-size: 11px;">
                                            <i class="bi bi-exclamation-triangle-fill"></i> @vencendoNaSemana.ToString(formato) @unidade expira(m) nos próximos 7 dias!
                                        </span>
                                    }
                                </td>
                                <td class="text-end py-3 text-secondary font-monospace sub-text-toggle">
                                    @estoque.ToString(formato)
                                </td>
                                <td class="text-end py-3 text-secondary font-monospace sub-text-toggle">
                                    @ponto.ToString(formato)
                                </td>
                                <td class="text-end py-3 text-muted font-monospace sub-text-toggle">
                                    @demanda.ToString(formato)
                                </td>
                                @* Coluna de Destaque: Valor numérico alinhado com o Badge da unidade ao lado *@
                                <td class="pe-4 text-end py-3 fw-bold text-dark font-monospace" style="background-color: #fff1ed; font-size: 15px;">
                                    <span class="me-1">@sugerido.ToString(formato)</span>
                                    <span class="badge bg-light text-secondary border px-1.5 py-1 font-monospace un-badge-toggle" style="border-radius: 4px; font-size: 10px; vertical-align: middle;">@unidade</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

