@model K_Gest.Models.DashboardViewModel
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid px-4 py-4">
    @* Topo com Título *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-speedometer2"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 var-text-color page-title">Painel de Controle</h2>
                <p class="text-muted small m-0 mt-1 sub-text-toggle">Visão Geral da Kantine Gestão (K_Gest)</p>
            </div>
        </div>

        @* Lado Direito: Botão Gerador de Lista + Data Atual *@
    <div class="d-flex align-items-center gap-4 flex-wrap">
    <div class="text-muted small fw-semibold sub-text-toggle">
        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
    </div>
    
    @* BOTÃO INTEGRADO: Direciona para a Action que criamos no InicioController *@
    <a asp-controller="Inicio" asp-action="GerarListaCompras" class="btn-salmon-dashboard d-inline-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-cart-check-fill"></i> Previsão de Compras
    </a>
</div>
    </div>

    @if (ViewBag.ErroDashboard != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 alert-danger-feedback" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small"><strong>Erro de conexão:</strong> @ViewBag.ErroDashboard</div>
        </div>
    }

    @* --- SEÇÃO 1: CARTÕES DE RESUMO --- *@
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card h-100 border-0 shadow-premium card-toggle">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class= "th-col-label text-uppercase fw-bold text-secondary small mb-1 sub-text-toggle">Insumos Cadastrados</h6>
                            <h2 class="display-6 fw-bold mb-0 text-dark var-text-color">@Model.TotalInsumos</h2>
                        </div>
                        <div class="icon-shape-salmon">
                            <i class="bi bi-basket3-fill"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2 sub-text-toggle">Vinculados a <span class="fw-bold text-dark var-text-color">@Model.TotalReceitas</span> fichas</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100 border-0 shadow-premium card-toggle">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class= "th-col-label text-uppercase fw-bold text-secondary small mb-1 sub-text-toggle">Abaixo do Mínimo</h6>
                            <h2 class="display-6 fw-bold mb-0 text-danger">@Model.InsumosAbaixoPontoPedido</h2>
                        </div>
                        <div class="icon-shape-danger-soft">
                            <i class="bi bi-cart-x-fill"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2 sub-text-toggle"><span class="fw-bold text-danger">@Model.InsumosZerados</span> itens totalmente zerados</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100 border-0 shadow-premium card-toggle">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class= "th-col-label text-uppercase fw-bold text-secondary small mb-1 sub-text-toggle">Validades Críticas</h6>
                            <h2 class="display-6 fw-bold mb-0 text-warning" style="color: #ca8a04 !important;">@Model.LotesEmAlerta</h2>
                        </div>
                        <div class="icon-shape-warning-soft">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2 sub-text-toggle"><span class="fw-bold text-danger">@Model.LotesVencidos</span> lotes já vencidos</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100 border-0 shadow-premium card-toggle">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class= "th-col-label text-uppercase fw-bold text-secondary small mb-1 sub-text-toggle">Faturamento (10d)</h6>
                            <h2 class="fs-3 fw-bold mb-0 text-dark mt-1 var-text-color">@Model.TotalVendidoDezDias.ToString("C2")</h2>
                        </div>
                        <div class="icon-shape-success-soft">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2 sub-text-toggle"><span class="fw-bold text-success">@Model.QtdPratosVendidos</span> pratos vendidos</div>
                </div>
            </div>
        </div>
    </div>

    @* --- SEÇÃO 2: GRÁFICOS --- *@
    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="card border-0 shadow-premium card-toggle card-section">
                <div class="card-header border-0 bg-transparent pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="p-2 bg-success-subtle rounded-3 text-success d-inline-flex">
                            <i class="bi bi-graph-up-arrow fs-5"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark m-0 var-text-color">Quantidades Entradas por Motivo</h5>
                            <p class="text-muted small m-0 sub-text-toggle">Análise de volumes adicionados ao estoque</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="chart-wrapper">
                        <canvas id="chartMotivosEntrada"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card border-0 shadow-premium card-toggle card-section">
                <div class="card-header border-0 bg-transparent pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="p-2 rounded-3 d-inline-flex" style="background-color: var(--salmon-soft); color: var(--salmon-primary);">
                            <i class="bi bi-graph-down-arrow fs-5"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark m-0 var-text-color">Quantidades Saídas por Motivo</h5>
                            <p class="text-muted small m-0 sub-text-toggle">Análise de volumes deduzidos (vendas, perdas, descartes)</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="chart-wrapper">
                        <canvas id="chartMotivosSaida"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SEÇÃO 3: TABELA DE ATIVIDADES RECENTES --- *@
    <div class="card border-0 shadow-premium mb-4 card-toggle card-section">
        <div class="card-header border-0 bg-transparent pt-4 px-4 pb-2">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 bg-light rounded-3 text-dark d-inline-flex border icon-table-toggle">
                    <i class="bi bi-clock-history fs-5"></i>
                </span>
                <div>
                    <h5 class="fw-bold text-dark m-0 var-text-color">Últimas Movimentações Realizadas</h5>
                    <p class="text-muted small m-0 sub-text-toggle">Registro em tempo real com justificativas vindas da tabela SQL</p>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-toggle">
                <thead class="thead-toggle table-head-default">
                    <tr>
                        <th class= "th-col-label ps-4 py-3 text-secondary text-uppercase fw-bold sub-text-toggle" style="width: 120px;">Tipo</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold sub-text-toggle">Insumo</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end sub-text-toggle">Quantidade</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold sub-text-toggle">Data/Hora</th>
                        <th class= "th-col-label pe-4 py-3 text-secondary text-uppercase fw-bold sub-text-toggle">Motivo / Justificativa</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @if (Model.UltimasMovimentacoes != null && Model.UltimasMovimentacoes.Any())
                    {
                        @foreach (var mov in Model.UltimasMovimentacoes)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    @if (mov.tipoEs == "E" || mov.tipoEs == "Entrada")
                                    {
                                        <span class="badge px-2.5 py-1.5 d-inline-flex align-items-center gap-1 badge-pill badge-pill-entrada">
                                            <i class="bi bi-arrow-down-left-circle-fill"></i> Entrada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-2.5 py-1.5 d-inline-flex align-items-center gap-1 badge-pill badge-pill-saida">
                                            <i class="bi bi-arrow-up-right-circle-fill"></i> Saída
                                        </span>
                                    }
                                </td>
                                <td class="py-3">
                                    <span class="fw-semibold text-dark fs-6 d-block var-text-color">@mov.NomeInsumo</span>
                                </td>
                                <td class="text-end py-3 fw-bold text-dark var-text-color">
                                    @(mov.UnidadeMed == "UN" ? mov.qtdMoviment.ToString("N0") : mov.qtdMoviment.ToString("N2"))
                                    <span class="badge bg-light text-secondary border px-1.5 py-0.5 font-monospace un-badge-toggle" style="border-radius: 4px; font-size: 10px;">@mov.UnidadeMed</span>
                                </td>
                                <td class="py-3 text-secondary small sub-text-toggle">
                                    @mov.dataMoviment.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="pe-4 py-3 text-dark fw-medium italic-motivo var-text-color">
                                    @(string.IsNullOrEmpty(mov.motivo) ? "Não informado" : mov.motivo)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5 sub-text-toggle">
                                <i class="bi bi-info-circle fs-3 d-block mb-2 text-secondary"></i>
                                <span class="fw-medium">Nenhuma movimentação cadastrada para exibir na tabela.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- SCRIPTS: GRAPHICS --- *@
<script>
    document.addEventListener("DOMContentLoaded", function () {

    let chartE, chartS;

    function formatarLegendasLongas(listaTextos) {
    if (!listaTextos) return [];
    return listaTextos.map(texto => {
    if (texto && texto.length > 25) {
    let palavras = texto.split(' ');
    let linhas = [];
    let linhaAtual = "";

    palavras.forEach(palavra => {
    if ((linhaAtual + palavra).length > 25) {
    linhas.push(linhaAtual.trim());
    linhaAtual = palavra + " ";
    } else {
    linhaAtual += palavra + " ";
    }
    });
    if (linhaAtual) linhas.push(linhaAtual.trim());
    return linhas;
    }
    return texto;
    });
    }

    const rawEntradas = @Html.Raw(Json.Serialize(Model?.MotivosEntrada)) || [];
    const qtdsEntrada = @Html.Raw(Json.Serialize(Model?.QtdsEntrada)) || [];
    const motivosEntrada = formatarLegendasLongas(rawEntradas);

    const rawSaidas = @Html.Raw(Json.Serialize(Model?.MotivosSaida)) || [];
    const qtdsSaida = @Html.Raw(Json.Serialize(Model?.QtdsSaida)) || [];
    const motivosSaida = formatarLegendasLongas(rawSaidas);

    function obterOpcoesGrafico(isDark) {
    return {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    layout: { padding: { left: 10, right: 25, top: 0, bottom: 0 } },
    plugins: { legend: { display: false } },
    scales: {
    x: {
    beginAtZero: true,
    grid: { color: isDark ? '#334155' : '#f1f5f9' },
    ticks: {
    color: isDark ? '#94a3b8' : '#475569',
    callback: function (value) { return value.toLocaleString('pt-BR'); }
    }
    },
    y: {
    grid: { display: false },
    ticks: {
    color: isDark ? '#cbd5e1' : '#475569',
    autoSkip: false,
    font: { size: 11, weight: '500', family: 'system-ui' },
    crossAlign: 'end'
    }
    }
    }
    };
    }

    const isDarkInitial = document.documentElement.classList.contains('dark-mode');

    // Inicialização do Gráfico de Entradas
    const ctxEntrada = document.getElementById('chartMotivosEntrada');
    if (ctxEntrada) {
    chartE = new Chart(ctxEntrada.getContext('2d'), {
    type: 'bar',
    data: {
    labels: motivosEntrada.length ? motivosEntrada : [["Sem registros", "de Entrada"]],
    datasets: [{
    label: 'Quantidade Movimentada',
    data: qtdsEntrada.length ? qtdsEntrada : [0],
    backgroundColor: '#10b981',
    borderRadius: 6,
    maxBarThickness: 25
    }]
    },
    options: obterOpcoesGrafico(isDarkInitial)
    });
    }

    // Inicialização do Gráfico de Saídas
    const ctxSaida = document.getElementById('chartMotivosSaida');
    if (ctxSaida) {
    chartS = new Chart(ctxSaida.getContext('2d'), {
    type: 'bar',
    data: {
    labels: motivosSaida.length ? motivosSaida : [["Sem registros", "de Saída"]],
    datasets: [{
    label: 'Quantidade Movimentada',
    data: qtdsSaida.length ? qtdsSaida : [0],
    backgroundColor: '#FF8C69',
    borderRadius: 6,
    maxBarThickness: 25
    }]
    },
    options: obterOpcoesGrafico(isDarkInitial)
    });
    }

    // Escuta a mudança de tema enviada pelo seu botão do _Layout alternando os eixos de cor de forma segura
    window.addEventListener('themeChanged', function () {
    const isDarkNow = document.documentElement.classList.contains('dark-mode');

    if (chartE) {
    chartE.options = obterOpcoesGrafico(isDarkNow);
    chartE.update();
    }
    if (chartS) {
    chartS.options = obterOpcoesGrafico(isDarkNow);
    chartS.update();
    }
    });

    // Executa uma atualização manual inicial em lote para garantir sincronismo com o estado do tema injetado no DOM
    setTimeout(() => {
    const isDarkDelayed = document.documentElement.classList.contains('dark-mode');
    if (chartE) { chartE.options = obterOpcoesGrafico(isDarkDelayed); chartE.update(); }
    if (chartS) { chartS.options = obterOpcoesGrafico(isDarkDelayed); chartS.update(); }
    }, 50);
    });
</script>