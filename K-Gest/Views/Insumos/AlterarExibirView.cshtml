@model K_Gest.Models.InsumosViewModel

@{
    ViewData["Title"] = "Editar Insumo";
}

<div class="container-fluid px-4 py-4" style="max-width: 900px; margin: 0 auto;">

    @* Navegação de Retorno *@
    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para a lista
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-pencil-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Alterar Insumo</h2>
            <p class="text-muted small m-0 mt-1">Atualize as informações de estoque e medidas do item selecionado.</p>
        </div>
    </div>

    @* Card do Formulário *@
    <div class="card border-0 shadow-premium" style="border-radius: 20px;  overflow: hidden;">
        <div class="card-body p-4 p-md-5">
            <form asp-action="AlterarProcessar" method="post">
                @* CAMPO OBRIGATÓRIO PARA O UPDATE *@
                <input type="hidden" asp-for="IdInsumo" />

                <div class="row g-4">
                    @* Nome do Insumo *@
                    <div class="col-12">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Nome do Insumo</label>
                        <div class="modern-input-group">
                            <i class="bi bi-tag-fill text-salmon"></i>
                            <input asp-for="NomeInsumo" class="form-control-modern" placeholder="Ex: Batata Inglesa" required />
                        </div>
                    </div>

                    @* Unidade de Medida *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Unidade de Medida</label>
                        <div class="modern-input-group">
                            <i class="bi bi-box-seam-fill text-salmon"></i>
                            <select asp-for="UnidadeMed" class="form-select-modern" required>
                                <option value="KG">Quilograma (KG)</option>
                                <option value="UN">Unidade (UN)</option>
                                <option value="L">Litro (L)</option>
                                <option value="G">Grama (G)</option>
                            </select>
                        </div>
                    </div>

                    @* Estoque Atual *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Estoque Atual</label>
                        <div class="modern-input-group">
                            <i class="bi bi-stack text-salmon"></i>
                            <input name="EstoqueAtual" type="text" class="form-control-modern font-monospace"
                                   value="@Model.EstoqueAtual.Value.ToString("F2")" />
                        </div>
                    </div>

                    @* Ponto de Pedido *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Ponto de Pedido (Mínimo)</label>
                        <div class="modern-input-group">
                            <i class="bi bi-exclamation-circle-fill text-salmon"></i>
                            <input name="PontoPedido" type="text" class="form-control-modern font-monospace"
                                   value="@Model.PontoPedido.Value.ToString("F2")" />
                        </div>
                    </div>

                    @* Rodapé de Ações *@
                    <div class="col-12 mt-5 d-flex gap-2">
                        <button type="submit" class="btn-salmon-action flex-grow-1 shadow-sm">
                            <i class="bi bi-cloud-check-fill me-2"></i> Salvar Alterações
                        </button>
                        <a asp-action="Selecionar" class="btn-cancel-modern">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

