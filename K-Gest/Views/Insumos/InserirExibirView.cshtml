@model K_Gest.Models.InsumosViewModel

@{
    ViewData["Title"] = "Cadastrar Novo Insumo";
}

<style>
    /* Remove as setas para Chrome, Safari, Edge e Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Remove as setas para Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="container mt-4">
    <h2>Cadastrar Insumo</h2>
    <hr />

    <form asp-action="InserirProcessar" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nome do Insumo</label>
                <input asp-for="NomeInsumo" class="form-control" placeholder="Ex: Farinha de Trigo" />
                <span asp-validation-for="NomeInsumo" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="UnidadeMed" class="form-label">Unidade de Medida</label>
                <select asp-for="UnidadeMed" class="form-select">
                    <option value="">-- Selecione uma Unidade --</option>
                    <option value="KG">Quilograma (KG)</option>
                    <option value="G">Grama (G)</option>
                    <option value="L">Litro (L)</option>
                    <option value="ML">Mililitro (ML)</option>
                    <option value="UN">Unidade (UN)</option>
                </select>
                <small class="text-muted">KG e L serão convertidos automaticamente.</small>
                <span asp-validation-for="UnidadeMed" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Estoque Inicial</label>
                <input asp-for="EstoqueAtual" type="number" step="0.01" lang="en-US" class="form-control" placeholder="0.00" />
                <span asp-validation-for="EstoqueAtual" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Ponto de Pedido (Mínimo)</label>
                <input asp-for="PontoPedido" type="number" step="0.01" lang="en-US" class="form-control" placeholder="0.00" />
                <span asp-validation-for="PontoPedido" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Salvar Insumo</button>
            <a asp-action="Selecionar" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>