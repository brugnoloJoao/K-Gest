@model K_Gest.Models.InsumosViewModel

@{
    ViewData["Title"] = "Cadastrar Novo Insumo";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-plus-lg"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Novo Insumo</h2>
            <p class="text-muted small m-0 mt-1">Insira os dados abaixo para registrar a matéria-prima ou mercadoria no estoque</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium" style="border-radius: 20px;  padding: 24px;">
        <form asp-action="InserirProcessar" method="post">

            <h5 class="text-dark fw-bold mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-info-circle me-1 text-salmon"></i> Informações Básicas
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Nome do Insumo</label>
                    <div class="input-group-custom">
                        <i class="bi bi-tag-fill text-salmon input-icon"></i>
                        <input asp-for="NomeInsumo" class="form-control-custom" placeholder="Ex: Farinha de Trigo ou Refrigerante" />
                    </div>
                    <span asp-validation-for="NomeInsumo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UnidadeMed" class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Unidade de Medida</label>
                    <div class="input-group-custom">
                        <i class="bi bi-box-seam-fill text-salmon input-icon"></i>
                        <select asp-for="UnidadeMed" class="form-select-custom">
                            <option value="">-- Selecione uma Unidade --</option>
                            <option value="KG">Quilograma (KG)</option>
                            <option value="G">Grama (G)</option>
                            <option value="L">Litro (L)</option>
                            <option value="ML">Mililitro (ML)</option>
                            <option value="UN">Unidade (UN)</option>
                        </select>
                    </div>
                    <div class="form-text text-muted mt-1" style="font-size: 11px;">
                        <i class="bi bi-lightning-charge text-warning"></i> Valores em <strong>KG</strong> e <strong>L</strong> se adaptam automaticamente.
                    </div>
                    <span asp-validation-for="UnidadeMed" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-boxes me-1 text-salmon"></i> Parâmetros de Inventário
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Estoque Inicial</label>
                    <div class="input-group-custom">
                        <i class="bi bi-stack text-salmon input-icon"></i>
                        <input asp-for="EstoqueAtual" type="number" step="0.01" lang="en-US" class="form-control-custom font-monospace" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="EstoqueAtual" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Ponto de Pedido (Mínimo Crítico)</label>
                    <div class="input-group-custom">
                        <i class="bi bi-exclamation-circle-fill text-salmon input-icon"></i>
                        <input asp-for="PontoPedido" type="number" step="0.01" lang="en-US" class="form-control-custom font-monospace" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="PontoPedido" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm"><i class="bi bi-check-lg me-1"></i> Salvar Registro</button>
            </div>
        </form>
    </div>
</div>

