@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Lista de Insumos";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Insumos Cadastrados</h2>
                <p class="text-muted small m-0 mt-1">Gerencie a quantidade atual e pontos de pedido dos materiais</p>
            </div>
        </div>
        <a asp-action="InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Novo Insumo
        </a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #fef2f2; color: #991b1b; border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                <thead style="background-color: #f8fafc; border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Nome do Insumo</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 120px;">Unidade</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px;">Estoque Atual</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px;">Ponto de Pedido</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 160px;">Status</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @foreach (DataRow row in Model.Rows)
                    {
                        var estoque = Convert.ToDecimal(row["estoqueAtual"]);
                        var pontoPedido = Convert.ToDecimal(row["pontoPedido"]);
                        var unidade = row["unidadeMed"].ToString();

                        <tr>
                            <td class="ps-4 py-3">
                                <span class="fw-semibold text-dark fs-6 d-block">@row["nomeInsumo"]</span>
                            </td>

                            <td class="text-center py-3">
                                <span class="badge bg-light text-secondary border px-2 py-1.5 font-monospace" style="border-radius: 6px; font-size: 12px;">@unidade</span>
                            </td>

                            <td class="text-end py-3 fw-bold text-dark">
                                @(unidade == "UN" ? estoque.ToString("N0") : estoque.ToString("N2"))
                            </td>
                            <td class="text-end py-3 text-secondary font-medium">
                                @(unidade == "UN" ? pontoPedido.ToString("N0") : pontoPedido.ToString("N2"))
                            </td>

                            <td class="text-center py-3">
                                @if (estoque <= 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600;">
                                        <i class="bi bi-x-circle-fill"></i> Zerado
                                    </span>
                                }
                                else if (estoque <= pontoPedido)
                                {
                                    <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600; color: #854d0e !important; background-color: #fef9c3 !important;">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Crítico
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600; color: #166534 !important; background-color: #dcfce7 !important;">
                                        <i class="bi bi-check-circle-fill"></i> Regular
                                    </span>
                                }
                            </td>

                            <td class="pe-4 text-center py-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="AlterarExibir"
                                       asp-route-idInsumo="@row["IdInsumo"]"
                                       class="btn-action-modern btn-edit-salmon"
                                       title="Editar Insumo">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="ExcluirExibir"
                                       asp-route-idInsumo="@row["IdInsumo"]"
                                       class="btn-action-modern btn-delete-salmon"
                                       title="Excluir Insumo">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

