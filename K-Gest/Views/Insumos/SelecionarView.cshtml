@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Lista de Insumos";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 page-header-flex">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 page-title">Insumos Cadastrados</h2>
                <p class="text-muted small m-0 mt-1">Gerencie a quantidade atual e pontos de pedido dos materiais</p>
            </div>
        </div>
        <a asp-action="InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Novo Insumo
        </a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert"
             style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert"
             style="background-color: #fef2f2; color: #991b1b; border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium card-section">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 620px;">
                <thead class="table-head-default">
                    <tr>
                        <th class= "th-col-label ps-4 py-3 text-secondary text-uppercase fw-bold">Nome do Insumo</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-center d-none d-sm-table-cell" style="width: 100px;">Unidade</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end">Estoque</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end d-none d-md-table-cell">Pto. Pedido</th>
                        <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-center" style="width: 110px;">Status</th>
                        <th class= "th-col-label pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="width: 100px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @foreach (DataRow row in Model.Rows)
                    {
                        var estoque = Convert.ToDecimal(row["estoqueAtual"]);
                        var pontoPedido = Convert.ToDecimal(row["pontoPedido"]);
                        var unidade = row["unidadeMed"].ToString();

                        <tr>
                            <td class="ps-4 py-3">
                                <span class="fw-semibold text-dark fs-6 d-block">@row["nomeInsumo"]</span>
                                <span class="badge bg-light text-secondary border font-monospace d-inline d-sm-none mt-1"
                                      style="border-radius: 6px; font-size: 11px;">@unidade</span>
                            </td>

                            <td class="text-center py-3 d-none d-sm-table-cell">
                                <span class="badge bg-light text-secondary border px-2 font-monospace"
                                      style="border-radius: 6px; font-size: 12px;">@unidade</span>
                            </td>

                            <td class="text-end py-3 fw-bold text-dark">
                                @(unidade == "UN" ? estoque.ToString("N0") : estoque.ToString("N2"))
                            </td>

                            <td class="text-end py-3 text-secondary d-none d-md-table-cell">
                                @(unidade == "UN" ? pontoPedido.ToString("N0") : pontoPedido.ToString("N2"))
                            </td>

                            <td class="text-center py-3">
                                @if (estoque <= 0)
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1 badge-pill badge-pill-zerado">
                                        <i class="bi bi-x-circle-fill"></i>
                                        <span class="d-none d-sm-inline">Zerado</span>
                                    </span>
                                }
                                else if (estoque <= pontoPedido)
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1 badge-pill badge-pill-critico">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <span class="d-none d-sm-inline">Crítico</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge d-inline-flex align-items-center gap-1 badge-pill badge-pill-regular">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span class="d-none d-sm-inline">Regular</span>
                                    </span>
                                }
                            </td>

                            <td class="pe-4 text-center py-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="AlterarExibir"
                                       asp-route-idInsumo="@row["IdInsumo"]"
                                       class="btn-action-modern btn-edit-salmon"
                                       title="Editar Insumo">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="ExcluirExibir"
                                       asp-route-idInsumo="@row["IdInsumo"]"
                                       class="btn-action-modern btn-delete-salmon"
                                       title="Excluir Insumo">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>