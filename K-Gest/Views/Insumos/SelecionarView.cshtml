@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Lista de Insumos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Insumos Cadastrados</h2>
        <a asp-action="InserirExibir" class="btn btn-success">Novo Insumo</a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success">@TempData["MsgSucesso"]</div>
    }

    <table class="table table-hover table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Unidade</th>
                <th class="text-end">Estoque Atual</th>
                <th class="text-end">Ponto de Pedido</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["nomeInsumo"]</td>
                    <td>@row["unidadeMed"]</td>
                    <td class="text-end">
                        @(row["unidadeMed"].ToString() == "UN"
                                            ? Convert.ToDecimal(row["estoqueAtual"]).ToString("N0")
                                            : Convert.ToDecimal(row["estoqueAtual"]).ToString("N2"))
                    </td>
                    <td class="text-end">
                        @(row["unidadeMed"].ToString() == "UN" 
                                            ? Convert.ToDecimal(row["pontoPedido"]).ToString("N0") 
                                            : Convert.ToDecimal(row["pontoPedido"]).ToString("N2"))
                    </td>
                    <td class="text-center">
                        @* O parâmetro deve se chamar 'idInsumo' e o campo do banco é 'IdInsumo' *@
                        <a asp-action="AlterarExibir"
                           asp-route-idInsumo="@row["IdInsumo"]"
                           class="btn btn-sm btn-warning">Editar</a>

                        <a asp-action="ExcluirExibir"
                           asp-route-idInsumo="@row["IdInsumo"]"
                           class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>