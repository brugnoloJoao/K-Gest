@model K_Gest.Models.MovimentacaoEstoqueViewModel

@{
    ViewData["Title"] = "Registrar Saída de Estoque";
}

<div class="container-fluid px-4 py-4 container-max-1000">

    <div class="mb-3">
        <a asp-action="Saidas" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-red">
            <i class="bi bi-box-arrow-up"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Registrar Saída</h2>
            <p class="text-muted small m-0 mt-1">Dê baixa em materiais consumidos, desperdiçados ou utilizados na produção</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium card-section-padded">
        <form asp-action="InserirProcessar" method="post">

            <input type="hidden" asp-for="TipoEs" value="S" />

            <div class="d-flex align-items-center justify-content-between mb-4 pb-2" style="border-bottom: 2px solid #f1f5f9;">
                <h5 class="text-dark fw-bold m-0" style="font-size: 15px;">
                    <i class="bi bi-box-seam me-1 text-salmon"></i> Material a ser retirado
                </h5>
                <span class="badge bg-danger-subtle text-danger px-3 py-2 d-inline-flex align-items-center gap-1 badge-pill badge-pill-saida">
                    <i class="bi bi-arrow-down-circle-fill"></i> Movimentação de Saída
                </span>
            </div>

            <div class="row g-4">
                <div class="col-md-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Insumo / Produto</label>
                    <div class="input-group-custom">
                        <i class="bi bi-search text-salmon input-icon"></i>
                        <select asp-for="IdInsumo" class="form-select-custom" asp-items="@Model.ListaInsumos">
                            <option value="">-- Selecione o Insumo para dar baixa --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdInsumo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2 form-section-title">
                <i class="bi bi-calculator me-1 text-salmon"></i> Quantidade e Justificativa
            </h5>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade Retirada</label>
                    <div class="input-group-custom">
                        <i class="bi bi-dash-circle-fill text-danger input-icon" style="opacity: 0.8;"></i>
                        <input asp-for="QtdMoviment" type="number" step="0.01" lang="en-US" class="form-control-custom font-monospace" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="QtdMoviment" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-8">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Motivo da Saída</label>
                    <div class="input-group-custom">
                        <i class="bi bi-chat-left-text-fill text-salmon input-icon"></i>
                        <input asp-for="Motivo" class="form-control-custom" placeholder="Ex: Consumo na cozinha, Produto vencido, Desperdício" />
                    </div>
                    <span asp-validation-for="Motivo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 form-footer-border">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Confirmar Retirada
                </button>
            </div>
        </form>
    </div>
</div>