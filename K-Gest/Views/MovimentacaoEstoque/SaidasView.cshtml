@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Saídas de Estoque";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-box-arrow-up"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 page-title">Saídas de Estoque</h2>
                <p class="text-muted small m-0 mt-1">Histórico de consumos, baixas e reduções de insumos no inventário</p>
            </div>
        </div>
        @if (ViewBag.SemInsumos != true)
        {
            <a asp-action="InserirSaida" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i> Nova Saída
            </a>
        }
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4 alert-success-feedback" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 alert-danger-feedback" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    @if (ViewBag.SemInsumos == true)
    {
        <div class="card border-0 shadow-premium py-5 text-center card-section">
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-4 empty-icon-circle">
                    <i class="bi bi-box-seam icon-size-xl"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Nenhum insumo cadastrado</h4>
                <p class="text-muted mx-auto mb-4 empty-desc">
                    Para gerenciar ou criar lotes, você precisa ter pelo menos um insumo cadastrado no sistema.
                </p>
                <a href="/Insumos/InserirExibir" class="btn-salmon-action d-inline-flex align-items-center gap-2 px-4 py-2.5 shadow-sm">
                    <i class="bi bi-plus-circle"></i> Cadastrar meu Primeiro Insumo
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-premium card-section">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 950px;">
                    @* Aumentado levemente o min-width para acomodar a nova coluna sem espremer *@
                    <thead class="table-head-default">
                        <tr>
                            <th class= "th-col-label ps-4 py-3 text-secondary text-uppercase fw-bold" style="width: 110px;">ID Mov.</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold" style="width: 140px;">Data Mov.</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold">Insumo</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end" style="width: 150px;">Qtd. Movimentada</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end" style="width: 150px;">Unidade de Medida</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold" style="padding-left: 40px;">Motivo / Justificativa</th>
                            <th class= "th-col-label pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="width: 120px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        @foreach (DataRow row in Model.Rows)
                        {
                            // Filtro visual: Garante que só mostra as saídas ("S")
                            if (row["tipoEs"].ToString() != "S") { continue; }

                            var idEstoque = row["idEstoque"].ToString();
                            var idInsumo = row["idInsumo"].ToString();
                            var qtdMoviment = Convert.ToDecimal(row["qtdMoviment"]);
                            var motivo = row["motivo"].ToString();

                            // Conversão e tratamento seguro do campo dataMoviment
                            var dataMov = row["dataMoviment"] != DBNull.Value ? Convert.ToDateTime(row["dataMoviment"]).ToString("dd/MM/yyyy HH:mm") : "-";

                            // Se você fez um JOIN com a tabela de insumos na Query, pode trocar por row["nomeInsumo"]
                            var nomeInsumo = row.Table.Columns.Contains("nomeInsumo") ? row["nomeInsumo"].ToString() : $"Insumo #{idInsumo}";

                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="badge bg-light text-secondary border px-2 py-1.5 font-monospace badge-id">#@idEstoque</span>
                                </td>

                                @* Nova Coluna de Data *@
                                <td class="py-3 text-secondary font-monospace small">
                                    @dataMov
                                </td>

                                <td class="py-3">
                                    <span class="fw-semibold text-dark fs-6 d-block">@nomeInsumo</span>
                                    <small class="text-muted font-monospace">ID Ref: @idInsumo</small>
                                </td>

                                <td class="text-end py-3 fw-bold text-danger">
                                    - @(row["unidadeMed"] == "UN" ? qtdMoviment.ToString("N0") : qtdMoviment.ToString("N2"))
                                </td>
                                <td class="text-end py-3 fw-bold text-danger">
                                    <span class="badge bg-light text-secondary border px-2 py-1.5 font-monospace badge-id">@row["unidadeMed"]</span>
                                </td>

                                <td class="py-3 text-secondary small" style="padding-left: 40px;">
                                    @(string.IsNullOrEmpty(motivo) ? "Não informado" : motivo)
                                </td>

                                <td class="pe-4 text-center py-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="ExcluirExibir"
                                           asp-route-idEstoque="@idEstoque"
                                           class="btn-action-modern btn-delete-salmon"
                                           title="Estornar/Excluir Saída">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>