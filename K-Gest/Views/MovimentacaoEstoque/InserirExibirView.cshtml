@model K_Gest.Models.MovimentacaoEstoqueViewModel

@{
    ViewData["Title"] = "Nova Movimentação de Estoque";
}

<div class="container-fluid px-4 py-4 container-max-1000">

    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-arrow-left-right"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Nova Movimentação</h2>
            <p class="text-muted small m-0 mt-1">Registre entradas ou saídas de materiais para manter o controle do saldo</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium card-section-padded">
        <form asp-action="InserirProcessar" method="post">

            <h5 class="text-dark fw-bold mb-4 pb-2 form-section-title">
                <i class="bi bi-box-seam me-1 text-salmon"></i> Detalhes do Item
            </h5>

            <div class="row g-4">
                <div class="col-md-8">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Insumo / Produto</label>
                    <div class="input-group-custom">
                        <i class="bi bi-search text-salmon input-icon"></i>
                        <select asp-for="IdInsumo" class="form-select-custom" asp-items="@Model.ListaInsumos">
                            <option value="">-- Selecione o Insumo para movimentar --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdInsumo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Tipo</label>
                    <div class="input-group-custom">
                        <i class="bi bi-arrow-down-up text-salmon input-icon"></i>
                        <select asp-for="TipoEs" class="form-select-custom">
                            <option value="">-- Tipo --</option>
                            <option value="E">Entrada (+)</option>
                            <option value="S">Saída (-)</option>
                        </select>
                    </div>
                    <span asp-validation-for="TipoEs" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2 form-section-title">
                <i class="bi bi-calculator me-1 text-salmon"></i> Quantidade e Justificativa
            </h5>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade</label>
                    <div class="input-group-custom">
                        <i class="bi bi-plus-circle-fill text-salmon input-icon"></i>
                        <input asp-for="QtdMoviment" type="number" step="0.01" lang="en-US" class="form-control-custom font-monospace" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="QtdMoviment" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-8">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Motivo / Justificativa</label>
                    <div class="input-group-custom">
                        <i class="bi bi-chat-left-text-fill text-salmon input-icon"></i>
                        <input asp-for="Motivo" class="form-control-custom" placeholder="Ex: Compra mensal, Desperdício, Ajuste de inventário" />
                    </div>
                    <span asp-validation-for="Motivo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 form-footer-border">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Confirmar Movimentação
                </button>
            </div>
        </form>
    </div>
</div>