@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Entradas de Estoque";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-box-arrow-in-down"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Entradas de Estoque</h2>
                <p class="text-muted small m-0 mt-1">Histórico de abastecimento e incrementos de insumos no inventário</p>
            </div>
        </div>
        <a asp-action="InserirEntrada" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Nova Entrada
        </a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #fef2f2; color: #991b1b; border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium" style="border-radius: 20px; overflow: hidden; ">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 950px;"> @* Expandido para 950px para acompanhar a inclusão da coluna *@
                <thead style="background-color: #f8fafc; border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; width: 110px;">ID Mov.</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; width: 140px;">Data Mov.</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Insumo</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Qtd. Movimentada</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Unidade de Medida</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; padding-left: 40px;">Motivo / Justificativa</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 120px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @foreach (DataRow row in Model.Rows)
                    {
                        // Filtro visual: Se a listagem trouxer tudo, garante que só mostra as entradas ("E").
                        if (row["tipoEs"].ToString() != "E") { continue; }

                        var idEstoque = row["idEstoque"].ToString();
                        var idInsumo = row["idInsumo"].ToString();
                        var qtdMoviment = Convert.ToDecimal(row["qtdMoviment"]);
                        var motivo = row["motivo"].ToString();

                        // Conversão e tratamento seguro do campo dataMoviment
                        var dataMov = row["dataMoviment"] != DBNull.Value ? Convert.ToDateTime(row["dataMoviment"]).ToString("dd/MM/yyyy HH:mm") : "-";

                        // Se você fez um JOIN com a tabela de insumos na Query, pode trocar por row["nomeInsumo"]
                        var nomeInsumo = row.Table.Columns.Contains("nomeInsumo") ? row["nomeInsumo"].ToString() : $"Insumo #{idInsumo}";

                        <tr>
                            <td class="ps-4 py-3">
                                <span class="badge text-secondary border px-2 py-1.5 font-monospace" style="border-radius: 6px; font-size: 12px;">#@idEstoque</span>
                            </td>

                            @* Nova Coluna de Data alinhada com o padrão das Saídas *@
                            <td class="py-3 text-secondary font-monospace small">
                                @dataMov
                            </td>

                            <td class="py-3">
                                <span class="fw-semibold text-dark fs-6 d-block">@nomeInsumo</span>
                                <small class="text-muted font-monospace">ID Ref: @idInsumo</small>
                            </td>

                            <td class="text-end py-3 fw-bold text-success">
                                + @(row["unidadeMed"] == "UN" ? qtdMoviment.ToString("N0") : qtdMoviment.ToString("N2"))
                            </td>
                            <td class="text-end py-3 fw-bold text-success">
                                <span class="badge text-secondary border px-2 py-1.5 font-monospace" style="border-radius: 6px; font-size: 12px;">@row["unidadeMed"]</span>
                            </td>
                            <td class="py-3 text-secondary small" style="padding-left: 40px;">
                                @(string.IsNullOrEmpty(motivo) ? "Não informado" : motivo)
                            </td>

                            <td class="pe-4 text-center py-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="ExcluirExibir"
                                       asp-route-idEstoque="@idEstoque"
                                       class="btn-action-modern btn-delete-salmon"
                                       title="Estornar/Excluir Entrada">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

