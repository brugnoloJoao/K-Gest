@model K_Gest.Models.MovimentacaoEstoqueViewModel

@{
    ViewData["Title"] = "Excluir Movimentação de Estoque";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon" style="background-color: #fee2e2; color: #dc2626;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Excluir Movimentação</h2>
            <p class="text-muted small m-0 mt-1">Atenção: verifique os detalhes abaixo antes de confirmar a exclusão deste registro</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium" style="border-radius: 20px; background: #ffffff; padding: 24px;">
        <form asp-action="ExcluirProcessar" method="post">

            <input type="hidden" asp-for="IdEstoque" />

            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #fffbeb; color: #92400e; border-radius: 12px;">
                <i class="bi bi-info-circle-fill me-2 fs-5" style="color: #d97706;"></i>
                <div class="fw-medium small">
                    Esta ação removerá o histórico do relatório. Certifique-se de reajustar o estoque atual manualmente se necessário.
                </div>
            </div>

            <h5 class="text-dark fw-bold mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-receipt me-1 text-salmon"></i> Dados do Registro #@Model.IdEstoque
            </h5>

            <div class="row g-4">
                @* Insumo / Produto *@
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-1 text-uppercase">Insumo / Produto</label>
                    <div class="p-2" style="background-color: #f8fafc; border-radius: 12px; border: 2px solid #f1f5f9; display: flex; align-items: center; height: 56px;">
                        <i class="bi bi-box-seam text-salmon ms-2 me-1" style="font-size: 16px;"></i>
                        <select asp-for="IdInsumo" class="form-select-custom border-0 bg-transparent py-1 shadow-none fw-bold text-dark fs-6" asp-items="@Model.ListaInsumos" disabled style="-webkit-appearance: none; -moz-appearance: none; appearance: none; cursor: not-allowed; opacity: 1;">
                            <option value="">-- Selecione o Insumo para movimentar --</option>
                        </select>
                    </div>
                </div>

                @* Tipo de Fluxo *@
                <div class="col-md-3">
                    <label class="form-label text-secondary fw-semibold small mb-1 text-uppercase">Tipo de Fluxo</label>
                    <div class="p-3 d-flex align-items-center justify-content-center" style="background-color: #f8fafc; border-radius: 12px; border: 2px solid #f1f5f9; height: 56px;">
                        @if (Model.TipoEs?.ToUpper() == "E" || Model.TipoEs?.ToUpper() == "ENTRADA")
                        {
                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 12px; font-weight: 600; color: #166534 !important; background-color: #dcfce7 !important;">
                                <i class="bi bi-arrow-down-left-circle-fill"></i> Entrada
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 12px; font-weight: 600; color: #991b1b !important; background-color: #fee2e2 !important;">
                                <i class="bi bi-arrow-up-right-circle-fill"></i> Saída
                            </span>
                        }
                    </div>
                </div>

                @* Quantidade Trata Dinâmica via Operador Ternário *@
                <div class="col-md-3">
                    <label class="form-label text-secondary fw-semibold small mb-1 text-uppercase">Quantidade</label>
                    <div class="p-3 text-end font-monospace fw-bold text-dark fs-6" style="background-color: #f8fafc; border-radius: 12px; border: 2px solid #f1f5f9; height: 56px;">
                        @{
                            var textoInsumo = Model.ListaInsumos?.FirstOrDefault(x => x.Value == Model.IdInsumo.ToString())?.Text ?? "";
                            bool isUn = textoInsumo.Contains("(UN)", StringComparison.OrdinalIgnoreCase);
                            bool isKgOrL = textoInsumo.Contains("(KG)", StringComparison.OrdinalIgnoreCase) || textoInsumo.Contains("(L)", StringComparison.OrdinalIgnoreCase);
                            string unidade = textoInsumo.Contains("(KG)", StringComparison.OrdinalIgnoreCase) ? "KG" : "L";
                        }
                        @(isUn 
                            ? Model.QtdMoviment.ToString("N0") + " UN" 
                            : isKgOrL 
                                ? (Model.QtdMoviment / 1000).ToString("N2") + " " + unidade 
                                : Model.QtdMoviment.ToString("N2"))
                    </div>
                </div>

                @* NOVA COLUNA: Data da Movimentação *@
                <div class="col-md-12">
                    <label class="form-label text-secondary fw-semibold small mb-1 text-uppercase">Data da Movimentação</label>
                    <div class="p-3 text-dark font-monospace fw-medium" style="background-color: #f8fafc; border-radius: 12px; border: 2px solid #f1f5f9; font-size: 14px;">
                        <i class="bi bi-calendar3 text-salmon me-2"></i>
                        @(Model.DataMoviment != null && Model.DataMoviment != DateTime.MinValue 
                            ? Model.DataMoviment.Value.ToString("HH:mm dd/MM/yyyy ") 
                            : "-")
                    </div>
                </div>

                @* Motivo / Justificativa *@
                <div class="col-md-12">
                    <label class="form-label text-secondary fw-semibold small mb-1 text-uppercase">Motivo / Justificativa informada</label>
                    <div class="p-3 text-secondary" style="background-color: #f8fafc; border-radius: 12px; border: 2px solid #f1f5f9; min-height: 56px; font-size: 14px;">
                        @(string.IsNullOrEmpty(Model.Motivo) ? "Não informado" : Model.Motivo)
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-delete shadow-sm">
                    <i class="bi bi-trash3 me-1"></i> Confirmar Exclusão
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    :root {
        --salmon-primary: #FF8C69;
        --salmon-soft: #fff1ed;
        --text-dark: #334155;
    }

    .icon-shape-salmon {
        width: 46px;
        height: 46px;
        background-color: var(--salmon-soft);
        color: var(--salmon-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 18px;
    }

    .text-salmon {
        color: var(--salmon-primary);
    }

    .btn-delete {
        background-color: #ef4444;
        color: #ffffff;
        font-weight: 600;
        font-size: 14px;
        padding: 12px 26px;
        border: none;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }

        .btn-delete:hover {
            background-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(239, 68, 68, 0.25) !important;
        }

    .btn-cancel {
        background-color: #f1f5f9;
        color: #64748b;
        font-weight: 600;
        font-size: 14px;
        padding: 12px 20px;
        border: none;
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s ease;
    }

        .btn-cancel:hover {
            background-color: #e2e8f0;
            color: var(--text-dark);
        }

    .back-link {
        color: var(--salmon-primary);
        transition: opacity 0.2s ease;
    }

        .back-link:hover {
            opacity: 0.8;
        }

    .shadow-premium {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02) !important;
    }
</style>