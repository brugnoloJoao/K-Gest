@model K_Gest.Models.MovimentacaoEstoqueViewModel

@{
    ViewData["Title"] = "Registrar Entrada de Estoque";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    <div class="mb-3">
        <a asp-action="Entradas" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon" style="background-color: #dcfce7; color: #15803d;">
            <i class="bi bi-box-arrow-in-down"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Registrar Entrada</h2>
            <p class="text-muted small m-0 mt-1">Adicione saldo ao estoque por compras, devoluções ou ajustes manuais</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium" style="border-radius: 20px;  padding: 24px;">
        <form asp-action="InserirProcessar" method="post">

            <!-- Campo oculto definindo que é uma Entrada -->
            <input type="hidden" asp-for="TipoEs" value="E" />

            <div class="d-flex align-items-center justify-content-between mb-4 pb-2" style="border-bottom: 2px solid #f1f5f9;">
                <h5 class="text-dark fw-bold m-0" style="font-size: 15px;">
                    <i class="bi bi-box-seam me-1 text-salmon"></i> Material a ser recebido
                </h5>
                <span class="badge bg-success-subtle text-success px-3 py-2 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 12px; font-weight: 600; color: #166534 !important; background-color: #dcfce7 !important;">
                    <i class="bi bi-arrow-down-left-circle-fill"></i> Movimentação de Entrada
                </span>
            </div>

            <div class="row g-4">
                <div class="col-md-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Insumo / Produto</label>
                    <div class="input-group-custom">
                        <i class="bi bi-search text-salmon input-icon"></i>
                        <select asp-for="IdInsumo" class="form-select-custom" asp-items="@Model.ListaInsumos">
                            <option value="">-- Selecione o Insumo para dar entrada --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdInsumo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-calculator me-1 text-salmon"></i> Quantidade e Justificativa
            </h5>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade Recebida</label>
                    <div class="input-group-custom">
                        <i class="bi bi-plus-circle-fill text-success input-icon" style="opacity: 0.8;"></i>
                        <input asp-for="QtdMoviment" type="number" step="0.01" lang="en-US" class="form-control-custom font-monospace" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="QtdMoviment" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-8">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Motivo da Entrada</label>
                    <div class="input-group-custom">
                        <i class="bi bi-chat-left-text-fill text-salmon input-icon"></i>
                        <input asp-for="Motivo" class="form-control-custom" placeholder="Ex: Compra de fornecedor, Ajuste de inventário, Devolução de cliente" />
                    </div>
                    <span asp-validation-for="Motivo" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Confirmar Entrada
                </button>
            </div>
        </form>
    </div>
</div>