@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Gerenciar Lotes";
    var unidadeMed = ViewBag.UnidadeMed?.ToString() ?? "UN";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-layers-fill"></i>
            </div>
            <div>
                <span class="text-secondary text-uppercase fw-bold small tracking-wider" style="font-size: 11px; letter-spacing: 0.5px;">Lotes Cadastrados do Insumo</span>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">
                    @ViewBag.NomeInsumo <span class="fs-5 text-muted fw-normal">(@unidadeMed)</span>
                </h2>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Lote/InserirExibir?idInsumo=@ViewBag.IdInsumo" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i> Cadastrar Novo Lote
            </a>
            <a href="/Lote/Selecionar" class="btn btn-outline-secondary d-flex align-items-center gap-2" style="border-radius: 12px; font-weight: 600; font-size: 14px; padding: 10px 20px;">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                <thead style="background-color: #f8fafc; border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; width: 120px;">Nº do Lote</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Data de Fabricação</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Data de Validade</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px;">Quantidade</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 220px;">Status Validade</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (DataRow dr in Model.Rows)
                        {
                            DateTime dtValidade = Convert.ToDateTime(dr["dtValidade"]);
                            string situacao = dr["situacao"]?.ToString() ?? "Regular / Próprio para consumo";
                            int diasRestantes = (dtValidade.Date - DateTime.Now.Date).Days;
                            string mensagemDias = diasRestantes == 0 ? "Hoje"
                                                                     : diasRestantes == 1 ? "Amanhã"
                                                                     : $"em {diasRestantes} Dias";
                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="fw-bold text-dark font-monospace fs-6">#@dr["numLote"]</span>
                                </td>

                                <td class="py-3 text-secondary">
                                    @Convert.ToDateTime(dr["dtFabricacao"]).ToString("dd/MM/yyyy")
                                </td>

                                <td class="py-3 text-dark fw-medium">
                                    @dtValidade.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end py-3 fw-bold text-dark">
                                    @(unidadeMed == "UN"
                                        ? Convert.ToDecimal(dr["quantidade"]).ToString("N0")
                                        : Convert.ToDecimal(dr["quantidade"]).ToString("N2"))
                                    <span class="text-muted fw-normal small">@unidadeMed</span>
                                </td>

                                <td class="text-center py-3">
                                    @if (situacao == "Vencido")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600;">
                                            <i class="bi bi-x-circle-fill"></i> Vencido
                                        </span>
                                    }
                                    else if (situacao == "Alerta")
                                    {

                                        <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600; color: #854d0e !important; background-color: #fef9c3 !important;">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Alerta (Vence @mensagemDias)
                                        </span>
                                    }
                                    else if (situacao == "Próximo da data de vencimento")
                                    {
                                        <span class="badge bg-info-subtle text-info px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600; color: #0b5ed7 !important; background-color: #e0f2fe !important;">
                                            <i class="bi bi-clock-history"></i> Próximo do Vencimento
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-2.5 py-1.5 d-inline-flex align-items-center gap-1" style="border-radius: 30px; font-size: 11px; font-weight: 600; color: #166534 !important; background-color: #dcfce7 !important;">
                                            <i class="bi bi-check-circle-fill"></i> Próprio para Consumo
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-center py-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Lote/AlterarExibir/@dr["idLote"]"
                                           class="btn-action-modern btn-edit-salmon"
                                           title="Editar Lote">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a href="/Lote/Excluir/@dr["idLote"]"
                                           class="btn-action-modern btn-delete-salmon"
                                           title="Excluir Lote"
                                           onclick="return confirm('Deseja realmente excluir este lote do estoque?')">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-info-circle fs-3 d-block mb-2 text-secondary"></i>
                                <span class="fw-medium">Nenhum lote ativo encontrado para este insumo.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --salmon-primary: #FF8C69;
        --salmon-hover: #fa7a52;
        --salmon-soft: #fff1ed;
    }

    /* Shape do Ícone do Cabeçalho */
    .icon-shape-salmon {
        width: 48px;
        height: 48px;
        background-color: var(--salmon-soft);
        color: var(--salmon-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
    }

    /* Botão Principal Salmão */
    .btn-salmon-action {
        background-color: var(--salmon-primary);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-salmon-action:hover {
            background-color: var(--salmon-hover);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(255, 140, 105, 0.25) !important;
        }

    /* Botões de Ações Modernos */
    .btn-action-modern {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        padding: 0;
        font-size: 15px;
        background-color: #f8fafc;
        transition: all 0.2s ease;
    }

    /* Estilo Editar */
    .btn-edit-salmon {
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

        .btn-edit-salmon:hover {
            border-color: var(--salmon-primary);
            color: white;
            background-color: var(--salmon-primary);
            box-shadow: 0 4px 10px rgba(255, 140, 105, 0.2);
        }

    /* Estilo Deletar */
    .btn-delete-salmon {
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

        .btn-delete-salmon:hover {
            border-color: #ef4444;
            color: white;
            background-color: #ef4444;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
        }

    /* Efeito suave de hover nas linhas da tabela */
    .table-hover tbody tr:hover {
        background-color: #f8fafc !important;
    }

    /* Ajustes nas bordas */
    .table > :not(caption) > * > * {
        border-bottom-width: 1px;
        border-bottom-color: #f1f5f9;
    }

    .shadow-premium {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02) !important;
    }
</style>