@using System.Data
@model DataTable

<div class="container mt-4">
    <div class="card bg-dark text-white shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center py-3">
            <div>
                <span class="text-info text-uppercase fw-bold small">Lotes Cadastrados do Insumo</span>
                <h3 class="mb-0">@ViewBag.NomeInsumo <span class="fs-5 text-muted">(@ViewBag.UnidadeMed)</span></h3>
            </div>
            <div>
                <a href="/Lote/InserirExibir?idInsumo=@ViewBag.IdInsumo" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i> Cadastrar Novo Lote
                </a>
                <a href="/Lote/Selecionar" class="btn btn-outline-light ms-2">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nº do Lote</th>
                        <th>Data de Fabricação</th>
                        <th>Data de Validade</th>
                        <th>Quantidade</th>
                        <th>Status Validade</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Rows.Count > 0)
                    {
                        foreach (DataRow dr in Model.Rows)
                        {
                            DateTime dtValidade = Convert.ToDateTime(dr["dtValidade"]);
                            
                            // Recupera a situação calculada pelo banco C# que configuramos no Lote.cs
                            string situacao = dr["situacao"]?.ToString() ?? "Regular / Próprio para consumo";
                            int diasRestantes = (dtValidade.Date - DateTime.Now.Date).Days;
                            string mensagemDias = diasRestantes == 0 ? "Hoje" 
                                                                     : diasRestantes == 1 ? "Amanhã" 
                                                                     : $"em {(dtValidade.Date - DateTime.Now.Date).Days} Dias";
                            <tr>
                                <td class="ps-4 align-middle fw-bold text-primary">#@dr["numLote"]</td>
                                <td class="align-middle">@Convert.ToDateTime(dr["dtFabricacao"]).ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">@dtValidade.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle">
                                    @(ViewBag.UnidadeMed.ToString() == "UN"
                                                    ? Convert.ToDecimal(dr["quantidade"]).ToString("N0")
                                                    : Convert.ToDecimal(dr["quantidade"]).ToString("N2"))
                                    @($" ({ViewBag.UnidadeMed})")
                                
                                </td>
                                <td class="align-middle">

                                    @* CORES ADAPTADAS PARA AS 4 CATEGORIAS PEDIDAS *@
                                    @if (situacao == "Vencido")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle-fill"></i> Vencido
                                        </span>
                                    }
                                    else if (situacao == "Alerta")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Alerta (Vence @mensagemDias)
                                        </span>
                                    }
                                    else if (situacao == "Próximo da data de vencimento")
                                    {
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-clock-history"></i> Próximo do Vencimento
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill"></i> Próprio para Consumo
                                        </span>
                                    }

                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <a href="/Lote/AlterarExibir/@dr["idLote"]" class="btn btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a href="/Lote/Excluir/@dr["idLote"]" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Deseja realmente excluir este lote do estoque?')">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                Nenhum lote ativo encontrado para este insumo.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>