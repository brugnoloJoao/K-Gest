@model K_Gest.Models.LoteViewModel

@{
    ViewData["Title"] = "Cadastrar Novo Lote no Estoque";
}

<div class="container-fluid px-4 py-4 container-max-1000">

    <div class="mb-3">
        <a href="@(Model.IdInsumo > 0 ? $"/Lote/GerenciarLotes?id={Model.IdInsumo}" : "/Lote/Selecionar")"
           class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-box-seam-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Cadastrar Novo Lote</h2>
            <p class="text-muted small m-0 mt-1">Insira os dados abaixo para fracionar e gerenciar a validade do estoque deste insumo</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium card-section-padded">
        <form asp-controller="Lote" asp-action="InserirProcessar" method="post" id="formLote">

            <input type="hidden" asp-for="IdInsumo" id="hdnIdInsumo" />

            <h5 class="text-dark fw-bold mb-4 pb-2 form-section-title">
                <i class="bi bi-info-circle me-1 text-salmon"></i> Origem do Lote
            </h5>

            <div class="row g-4">
                <div class="col-md-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Insumo / Ingrediente</label>
                    <div class="input-group-custom">
                        <i class="bi bi-tag-fill text-salmon input-icon"></i>
                        <select id="selInsumo" asp-items="Model.ListaInsumos" class="form-select-custom"
                                style="@(Model.IdInsumo > 0 ? "pointer-events: none; background-color: #f8fafc; opacity: 0.8;" : "")">
                            <option value="">-- Escolha o Insumo para este Lote --</option>
                        </select>
                    </div>
                    @if (Model.IdInsumo > 0)
                    {
                        <div class="form-text text-muted mt-2" style="font-size: 11px;">
                            <i class="bi bi-lock-fill text-secondary"></i> Vinculado automaticamente ao insumo selecionado na tela anterior.
                        </div>
                    }
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2 form-section-title">
                <i class="bi bi-boxes me-1 text-salmon"></i> Dados do Lote e Quantidade
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Número do Lote</label>
                    <div class="input-group-custom">
                        <i class="bi bi-hash text-salmon input-icon" style="font-size: 16px;"></i>
                        <input type="number" asp-for="NumLote" id="txtNumLote" class="form-control-custom font-monospace" placeholder="Ex: 202605" required min="1" />
                    </div>
                    <span asp-validation-for="NumLote" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade de Entrada</label>
                    <div class="input-group-custom">
                        <i class="bi bi-stack text-salmon input-icon"></i>
                        <input type="number" asp-for="Quantidade" id="txtQuantidade" step="0.01" class="form-control-custom font-monospace" placeholder="Ex: 50.00" required min="0.01" />
                    </div>
                    <span asp-validation-for="Quantidade" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <h5 class="text-dark fw-bold mt-5 mb-4 pb-2 form-section-title">
                <i class="bi bi-calendar-range me-1 text-salmon"></i> Prazos e Validade
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data de Fabricação</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar-check text-salmon input-icon"></i>
                        <input type="date" asp-for="DtFabricacao" id="txtDtFabricacao" class="form-control-custom text-secondary" asp-format="{0:yyyy-MM-dd}" required />
                    </div>
                    <span asp-validation-for="DtFabricacao" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data de Validade</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar-x text-salmon input-icon"></i>
                        <input type="date" asp-for="DtValidade" id="txtDtValidade" class="form-control-custom text-secondary" asp-format="{0:yyyy-MM-dd}" required />
                    </div>
                    <span asp-validation-for="DtValidade" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 form-footer-border">
                <a href="@(Model.IdInsumo > 0 ? $"/Lote/GerenciarLotes?id={Model.IdInsumo}" : "/Lote/Selecionar")" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm"><i class="bi bi-check-lg me-1"></i> Salvar Lote</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Sincroniza dinamicamente o select visual com o input hidden do IdInsumo
        const selInsumo = document.getElementById('selInsumo');
        const hdnIdInsumo = document.getElementById('hdnIdInsumo');

        if (selInsumo && hdnIdInsumo && hdnIdInsumo.value) {
            selInsumo.value = hdnIdInsumo.value;
        }

        selInsumo.addEventListener('change', function () {
            hdnIdInsumo.value = this.value;
        });

        // Validação nativa customizada para consistência das datas
        const form = document.getElementById('formLote');
        form.addEventListener('submit', function (e) {
            const inputFabricacao = document.getElementById('txtDtFabricacao');
            const inputValidade = document.getElementById('txtDtValidade');

            if (inputFabricacao && inputValidade && inputFabricacao.value && inputValidade.value) {
                const dtFab = new Date(inputFabricacao.value);
                const dtVal = new Date(inputValidade.value);

                if (dtVal <= dtFab) {
                    e.preventDefault();

                    // Alerta estilizado nativo do navegador modificado ou pode usar Toast se possuir no sistema
                    alert('Atenção: A data de validade deve ser obrigatoriamente maior do que a data de fabricação do lote.');
                }
            }
        });
    </script>
}