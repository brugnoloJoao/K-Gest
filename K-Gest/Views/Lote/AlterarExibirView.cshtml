@model K_Gest.Models.LoteViewModel

@{
    ViewData["Title"] = "Editar Lote";
}

<div class="container-fluid px-4 py-4 container-max-900">

    @* Navegação de Retorno Dinâmica para o Gerenciador do Insumo *@
    <div class="mb-3">
        <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para os lotes
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-pencil-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Alterar Lote</h2>
            <p class="text-muted small m-0 mt-1">Atualize as informações de identificação, validades e volumes deste lote.</p>
        </div>
    </div>

    @* Card do Formulário *@
    <div class="card border-0 shadow-premium card-section">
        <div class="card-body p-4 p-md-5">
            <form asp-action="AlterarProcessar" method="post">
                @* CAMPOS OBRIGATÓRIOS PARA O UPDATE E MAPEAMENTO *@
                <input type="hidden" asp-for="IdLote" />
                <input type="hidden" asp-for="IdInsumo" />

                <div class="row g-4">
                    @* Número do Lote *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Número do Lote</label>
                        <div class="modern-input-group">
                            <i class="bi bi-hash text-salmon"></i>
                            <input asp-for="NumLote" type="number" class="form-control-modern font-monospace" placeholder="Ex: 20240101" required />
                        </div>
                    </div>

                    @* Quantidade do Lote *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Quantidade</label>
                        <div class="modern-input-group">
                            <i class="bi bi-box-seam-fill text-salmon"></i>
                            <input asp-for="Quantidade" 
                                   type="number" 
                                   step="0.01" 
                                   value="@Model.Quantidade.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                   class="form-control-modern font-monospace" 
                                   required />
                        </div>
                    </div>

                    @* Data de Fabricação *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Data de Fabricação</label>
                        <div class="modern-input-group">
                            <i class="bi bi-calendar-check text-salmon"></i>
                            <input asp-for="DtFabricacao" type="date" class="form-control-modern" required />
                        </div>
                    </div>

                    @* Data de Validade *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Data de Validade</label>
                        <div class="modern-input-group">
                            <i class="bi bi-calendar-x text-salmon"></i>
                            <input asp-for="DtValidade" type="date" class="form-control-modern" required />
                        </div>
                    </div>

                    @* Rodapé de Ações *@
                    <div class="col-12 mt-5 d-flex gap-2">
                        <button type="submit" class="btn-salmon-action flex-grow-1 shadow-sm">
                            <i class="bi bi-cloud-check-fill me-2"></i> Salvar Alterações
                        </button>
                        <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="btn-cancel-modern text-center">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>