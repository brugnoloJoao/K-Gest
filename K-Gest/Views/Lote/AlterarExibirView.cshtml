@model K_Gest.Models.LoteViewModel

@{
    ViewData["Title"] = "Editar Lote";
}

<div class="container-fluid px-4 py-4" style="max-width: 900px; margin: 0 auto;">

    @* Navegação de Retorno Dinâmica para o Gerenciador do Insumo *@
    <div class="mb-3">
        <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para os lotes
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-pencil-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Alterar Lote</h2>
            <p class="text-muted small m-0 mt-1">Atualize as informações de identificação, validades e volumes deste lote.</p>
        </div>
    </div>

    @* Card do Formulário *@
    <div class="card border-0 shadow-premium" style="border-radius: 20px; background: #ffffff; overflow: hidden;">
        <div class="card-body p-4 p-md-5">
            <form asp-action="AlterarProcessar" method="post">
                @* CAMPOS OBRIGATÓRIOS PARA O UPDATE E MAPEAMENTO *@
                <input type="hidden" asp-for="IdLote" />
                <input type="hidden" asp-for="IdInsumo" />

                <div class="row g-4">
                    @* Número do Lote *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Número do Lote</label>
                        <div class="modern-input-group">
                            <i class="bi bi-hash text-salmon"></i>
                            <input asp-for="NumLote" type="number" class="form-control-modern font-monospace" placeholder="Ex: 20240101" required />
                        </div>
                    </div>

                    @* Quantidade do Lote (Mudado para asp-for para não quebrar o binding) *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Quantidade</label>
                        <div class="modern-input-group">
                            <i class="bi bi-box-seam-fill text-salmon"></i>
                            <input asp-for="Quantidade" type="text" class="form-control-modern font-monospace" required />
                        </div>
                    </div>

                    @* Data de Fabricação *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Data de Fabricação</label>
                        <div class="modern-input-group">
                            <i class="bi bi-calendar-check text-salmon"></i>
                            <input asp-for="DtFabricacao" type="date" class="form-control-modern" required />
                        </div>
                    </div>

                    @* Data de Validade *@
                    <div class="col-md-6">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Data de Validade</label>
                        <div class="modern-input-group">
                            <i class="bi bi-calendar-x text-salmon"></i>
                            <input asp-for="DtValidade" type="date" class="form-control-modern" required />
                        </div>
                    </div>

                    @* Rodapé de Ações *@
                    <div class="col-12 mt-5 d-flex gap-2">
                        <button type="submit" class="btn-salmon-action flex-grow-1 shadow-sm">
                            <i class="bi bi-cloud-check-fill me-2"></i> Salvar Alterações
                        </button>
                        <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="btn-cancel-modern text-center">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --salmon-primary: #FF8C69; /* Salmão Principal */
        --salmon-hover: #fa7a52; /* Salmão um pouco mais escuro */
        --salmon-soft: #fff1ed; /* Fundo salmão bem clarinho */
        --text-dark: #334155;
    }

    /* Estilo do Ícone de Topo */
    .icon-shape-salmon {
        width: 48px;
        height: 48px;
        background-color: var(--salmon-soft);
        color: var(--salmon-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
    }

    /* Grupo de Input Moderno */
    .modern-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

        .modern-input-group i {
            position: absolute;
            left: 16px;
            z-index: 10;
            font-size: 18px;
        }

    .text-salmon {
        color: var(--salmon-primary);
    }

    /* Estilização dos Campos */
    .form-control-modern {
        width: 100%;
        padding: 12px 16px 12px 48px;
        background-color: #f8fafc;
        border: 2px solid #f1f5f9;
        border-radius: 12px;
        color: var(--text-dark);
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .form-control-modern:focus {
            background-color: #fff;
            border-color: var(--salmon-primary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(255, 140, 105, 0.15);
        }

    /* Botões */
    .btn-salmon-action {
        background-color: var(--salmon-primary);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .btn-salmon-action:hover {
            background-color: var(--salmon-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(255, 140, 105, 0.3) !important;
        }

    .btn-cancel-modern {
        background-color: #f1f5f9;
        color: #64748b;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-cancel-modern:hover {
            background-color: #e2e8f0;
            color: #334155;
        }

    /* Link de Voltar */
    .back-link {
        color: var(--salmon-primary);
        transition: opacity 0.2s;
    }

        .back-link:hover {
            opacity: 0.8;
        }

    .shadow-premium {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02) !important;
    }
</style>