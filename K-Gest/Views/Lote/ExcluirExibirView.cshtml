@model K_Gest.Models.LoteViewModel

@{
    ViewData["Title"] = "Excluir Lote";
}

<div class="container-fluid px-4 py-4 container-max-900">

    @* Navegação de Retorno Dinâmica para o Gerenciador do Insumo *@
    <div class="mb-3">
        <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para os lotes
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-danger">
            <i class="bi bi-trash3-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Excluir Lote</h2>
            <p class="text-muted small m-0 mt-1">Confirme os detalhes abaixo antes de prosseguir com a exclusão definitiva.</p>
        </div>
    </div>

    @* Alerta de Atenção *@
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4 alert-warning-feedback" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div class="fw-medium small"><strong>Atenção:</strong> Esta ação não poderá ser desfeita. A exclusão deste lote removerá permanentemente o registro e suas respectivas quantidades do sistema.</div>
    </div>

    @* Card do Formulário (Read-only) *@
    <div class="card border-0 shadow-premium card-section-padded">
        <form asp-action="ExcluirProcessar" method="post">

            @* CAMPOS OCULTOS PARA PROCESSAMENTO *@
            <input type="hidden" asp-for="IdLote" />
            <input type="hidden" asp-for="IdInsumo" />

            <h5 class="text-dark fw-bold mb-4 pb-2 form-section-title">
                <i class="bi bi-info-circle me-1 text-secondary"></i> Dados do Lote Selecionado
            </h5>

            <div class="row g-4">
                @* Número do Lote *@
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Número do Lote</label>
                    <div class="input-group-custom">
                        <i class="bi bi-hash text-secondary input-icon"></i>
                        <input asp-for="NumLote" type="number" class="form-control-custom font-monospace" disabled />
                    </div>
                </div>

                @* Quantidade do Lote *@
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade</label>
                    <div class="input-group-custom">
                        <i class="bi bi-box-seam-fill text-secondary input-icon"></i>
                        <input asp-for="Quantidade"
                               type="number"
                               step="0.01"
                               value="@Model.Quantidade.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control-custom font-monospace"
                               disabled />
                    </div>
                </div>

                @* Data de Fabricação *@
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data de Fabricação</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar-check text-secondary input-icon"></i>
                        <input asp-for="DtFabricacao" type="date" class="form-control-custom" disabled />
                    </div>
                </div>

                @* Data de Validade *@
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data de Validade</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar-x text-secondary input-icon"></i>
                        <input asp-for="DtValidade" type="date" class="form-control-custom" disabled />
                    </div>
                </div>
            </div>

            @* Rodapé de Ações *@
            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3 form-footer-border">
                <a asp-action="GerenciarLotes" asp-route-id="@Model.IdInsumo" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-delete shadow-sm">
                    <i class="bi bi-trash3 me-1"></i> Excluir Definitivamente
                </button>
            </div>

        </form>
    </div>
</div>