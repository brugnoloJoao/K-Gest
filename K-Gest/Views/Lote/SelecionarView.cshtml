@using System.Data
@model DataTable

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam"></i> Controle de Estoque por Lotes</h2>
        <span class="text-muted">Selecione um insumo para ver ou adicionar lotes</span>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Rows.Count > 0)
        {
            foreach (DataRow dr in Model.Rows)
            {
                // Identifica dinamicamente os nomes das colunas para não quebrar por maiúsculas/minúsculas
                string colId = dr.Table.Columns.Contains("idInsumo") ? "idInsumo" : (dr.Table.Columns.Contains("IdInsumo") ? "IdInsumo" : dr.Table.Columns[0].ColumnName);
                string colNome = dr.Table.Columns.Contains("nomeInsumo") ? "nomeInsumo" : (dr.Table.Columns.Contains("NomeInsumo") ? "NomeInsumo" : "Nome");
                string colUnidade = dr.Table.Columns.Contains("unidadeMed") ? "unidadeMed" : (dr.Table.Columns.Contains("UnidadeMed") ? "UnidadeMed" : "unidadeMed");

                var idInsumo = dr[colId];
                var nomeInsumo = dr[colNome];
                var unidadeMed = dr[colUnidade];

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold text-dark mb-0">@nomeInsumo</h5>
                                    <span class="badge bg-secondary">@unidadeMed</span>
                                </div>
                                <p class="card-text text-muted small">Cód. Insumo: #@idInsumo</p>
                            </div>

                            <a href="/Lote/GerenciarLotes?id=@idInsumo" class="btn btn-primary w-100 mt-3">
                                <i class="bi bi-eye"></i> Gerenciar Lotes
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Nenhum insumo cadastrado no sistema.</p>
            </div>
        }
    </div>
</div>