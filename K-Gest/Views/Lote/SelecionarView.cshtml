@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Controle de Lotes";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-layers-half"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Controle de Estoque por Lotes</h2>
                <p class="text-muted small m-0 mt-1">Selecione um insumo para visualizar, rastrear ou adicionar novos lotes de validade</p>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        @if (Model != null && Model.Rows.Count > 0)
        {
            foreach (DataRow dr in Model.Rows)
            {
                // Identificação dinâmica de colunas para evitar quebras por CapsLock
                string colId = dr.Table.Columns.Contains("idInsumo") ? "idInsumo" : (dr.Table.Columns.Contains("IdInsumo") ? "IdInsumo" : dr.Table.Columns[0].ColumnName);
                string colNome = dr.Table.Columns.Contains("nomeInsumo") ? "nomeInsumo" : (dr.Table.Columns.Contains("NomeInsumo") ? "NomeInsumo" : "Nome");
                string colUnidade = dr.Table.Columns.Contains("unidadeMed") ? "unidadeMed" : (dr.Table.Columns.Contains("UnidadeMed") ? "UnidadeMed" : "unidadeMed");

                var idInsumo = dr[colId];
                var nomeInsumo = dr[colNome];
                var unidadeMed = dr[colUnidade];

                <div class="col">
                    <div class="card h-100 border-0 shadow-premium lote-card" style="border-radius: 20px; background: #ffffff; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                    <h5 class="fw-bold text-dark mb-0 fs-6 lh-base text-truncate-2" title="@nomeInsumo">@nomeInsumo</h5>
                                    <span class="badge bg-light text-secondary border px-2 py-1.5 font-monospace" style="border-radius: 6px; font-size: 11px;">@unidadeMed</span>
                                </div>
                                <div class="d-flex align-items-center gap-1.5 text-secondary mb-2" style="font-size: 12px; font-weight: 500;">
                                    <span class="badge font-monospace" style="background-color: #f1f5f9; color: #64748b; border-radius: 6px; font-size: 11px;">#@idInsumo</span>
                                    <span class="text-muted small">Cód. Insumo</span>
                                </div>
                            </div>

                            <div class="mt-4">
                                <a href="/Lote/GerenciarLotes?id=@idInsumo" class="btn-action-block btn-edit-salmon d-flex align-items-center justify-content-center gap-2 w-100">
                                    <i class="bi bi-eye-fill"></i> Gerenciar Lotes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted bg-light d-inline-flex p-4 rounded-circle mb-3">
                    <i class="bi bi-box-seam text-secondary fs-2"></i>
                </div>
                <p class="text-secondary fw-medium">Nenhum insumo cadastrado no sistema para controle de lotes.</p>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --salmon-primary: #FF8C69;
        --salmon-hover: #fa7a52;
        --salmon-soft: #fff1ed;
    }

    /* Shape do Ícone do Cabeçalho principal */
    .icon-shape-salmon {
        width: 48px;
        height: 48px;
        background-color: var(--salmon-soft);
        color: var(--salmon-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
    }

    /* Botão em Bloco para Cards */
    .btn-action-block {
        height: 42px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 13.5px;
        text-decoration: none;
        background-color: #f8fafc;
        transition: all 0.2s ease;
    }

    /* Estilo Especial Interativo Salmão para o Botão do Card */
    .btn-edit-salmon {
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

        .btn-edit-salmon:hover {
            border-color: var(--salmon-primary);
            color: white;
            background-color: var(--salmon-primary);
            box-shadow: 0 5px 12px rgba(255, 140, 105, 0.25);
        }

    /* Efeito de elevação sutil no card inteiro ao passar o mouse */
    .lote-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 25px 35px -5px rgba(0, 0, 0, 0.08), 0 12px 15px -5px rgba(0, 0, 0, 0.03) !important;
    }

    /* Limitador de texto para nomes longos de insumos não quebrarem o layout */
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Sombras Premium Padronizadas */
    .shadow-premium {
        box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.03), 0 8px 10px -5px rgba(0, 0, 0, 0.01) !important;
    }
</style>