@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Histórico de Vendas";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 page-title">Histórico de Vendas</h2>
                <p class="text-muted small m-0 mt-1">Monitore e gerencie o histórico de vendas realizadas</p>
            </div>
        </div>

        @* O botão de Registrar Venda só faz sentido ficar ativo se houverem vendas ou pratos disponíveis *@
        @if (ViewBag.SemReceitas != true)
        {
            <a asp-action="InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i> Registrar Venda
            </a>
        }
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4 alert-success-feedback" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 alert-danger-feedback" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    @if (ViewBag.SemReceitas == true)
    {
        <div class="card border-0 shadow-premium py-5 text-center card-section">
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-4 empty-icon-circle">
                    <i class="bi bi-egg-fried icon-size-xl" ></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Nenhuma receita cadastrada</h4>
                <p class="text-muted mx-auto mb-4 empty-desc">
                    Para gerenciar o histórico de vendas, você precisa ter pelo menos uma receita cadastrada no sistema.
                </p>
                <a href="/Receitas/InserirExibir" class="btn-salmon-action d-inline-flex align-items-center gap-2 px-4 py-2.5 shadow-sm">
                    <i class="bi bi-plus-circle"></i> Cadastrar minha Primeira Receita
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-premium card-section">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-head-default">
                        <tr>
                            <th class= "th-col-label ps-4 py-3 text-secondary text-uppercase fw-bold" style="width: 100px;">Cód. Venda</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-center" style="width: 150px;">Data da Venda</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold">Receita / Produto</th>
                            <th class= "th-col-label py-3 text-secondary text-uppercase fw-bold text-end" style="width: 150px;">Qtd. Vendida</th>
                            <th class= "th-col-label pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        @foreach (DataRow row in Model.Rows)
                        {
                            var dataVenda = Convert.ToDateTime(row["dataVend"].ToString());
                            var qtdVendida = Convert.ToDecimal(row["qtdVendida"].ToString());

                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="text-secondary font-monospace" style="font-size: 13px;">#@row["idVendas"]</span>
                                </td>

                                <td class="text-center py-3 text-secondary" style="font-size: 14px;">
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px;">
                                        <i class="bi bi-calendar3 me-1 text-secondary"></i> @dataVenda.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td class="py-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold text-dark fs-6">
                                            @(row.Table.Columns.Contains("nomePrato") ? row["nomePrato"] : "Prato não encontrado.")
                                        </span>
                                    </div>
                                </td>

                                <td class="text-end py-3 fw-bold text-dark fs-6">
                                    @qtdVendida.ToString("N0")
                                </td>

                                <td class="pe-4 text-center py-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="ExcluirExibir"
                                           asp-route-idVendas="@row["idVendas"]"
                                           class="btn-action-modern btn-delete-salmon"
                                           title="Excluir Registro de Venda">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>