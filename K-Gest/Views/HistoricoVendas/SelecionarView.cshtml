@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Histórico de Vendas";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Histórico de Vendas</h2>
                <p class="text-muted small m-0 mt-1">Monitore e gerencie o histórico de vendas realizadas</p>
            </div>
        </div>
        <a asp-action="InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Registrar Venda
        </a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                <thead style="background-color: #f8fafc; border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; width: 100px;">Cód. Venda</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Data da Venda</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Receita / Produto</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold text-end" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Qtd. Vendida</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @foreach (DataRow row in Model.Rows)
                    {
                        var dataVenda = Convert.ToDateTime(row["dataVend"].ToString());
                        var qtdVendida = Convert.ToDecimal(row["qtdVendida"].ToString());

                        <tr>
                            <td class="ps-4 py-3">
                                <span class="text-secondary font-monospace" style="font-size: 13px;">#@row["idVendas"]</span>
                            </td>

                            <td class="text-center py-3 text-secondary" style="font-size: 14px;">
                                <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px;">
                                    <i class="bi bi-calendar3 me-1 text-secondary"></i> @dataVenda.ToString("dd/MM/yyyy")
                                </span>
                            </td>

                            <td class="py-3">
                                <div class="d-flex flex-column">
                                    <span class="fw-semibold text-dark fs-6">
                                        @(row.Table.Columns.Contains("nomePrato") ? row["nomePrato"] : "Prato não encontrado.")
                                    </span>
                                </div>
                            </td>

                            <td class="text-end py-3 fw-bold text-dark fs-6">
                                @qtdVendida.ToString("N0")
                            </td>

                            <td class="pe-4 text-center py-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="ExcluirExibir"
                                       asp-route-idVendas="@row["idVendas"]"
                                       class="btn-action-modern btn-delete-salmon"
                                       title="Excluir Registro de Venda">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --salmon-primary: #FF8C69;
        --salmon-hover: #fa7a52;
        --salmon-soft: #fff1ed;
    }

    /* Shape do Ícone do Cabeçalho */
    .icon-shape-salmon {
        width: 48px;
        height: 48px;
        background-color: var(--salmon-soft);
        color: var(--salmon-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
    }

    /* Botão Principal Salmão */
    .btn-salmon-action {
        background-color: var(--salmon-primary);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-salmon-action:hover {
            background-color: var(--salmon-hover);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(255, 140, 105, 0.25) !important;
        }

    /* Botões de Ações Modernos */
    .btn-action-modern {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        padding: 0;
        font-size: 15px;
        background-color: #f8fafc;
        transition: all 0.2s ease;
    }

    /* Estilo Deletar */
    .btn-delete-salmon {
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

        .btn-delete-salmon:hover {
            border-color: #ef4444;
            color: white;
            background-color: #ef4444;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
        }

    /* Efeito de hover nas linhas da tabela */
    .table-hover tbody tr:hover {
        background-color: #f8fafc !important;
    }

    /* Ajustes nas bordas */
    .table > :not(caption) > * > * {
        border-bottom-width: 1px;
        border-bottom-color: #f1f5f9;
    }

    .shadow-premium {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02) !important;
    }
</style>