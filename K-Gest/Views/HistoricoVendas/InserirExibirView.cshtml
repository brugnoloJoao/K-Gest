@model K_Gest.Models.HistoricoVendasViewModel;

@{
    ViewData["Title"] = "Registrar Nova Venda";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para o histórico
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-plus-lg"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Registrar Venda</h2>
            <p class="text-muted small m-0 mt-1">Insira os dados abaixo para computar a venda e atualizar o histórico</p>
        </div>
    </div>

    <div class="card border-0 shadow-premium" style="border-radius: 20px; background: #ffffff; padding: 24px;">
        <form asp-action="InserirProcessar" method="post">

            <h5 class="text-dark fw-bold mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-info-circle me-1 text-salmon"></i> Informações da Venda
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data da Venda</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar3 text-salmon input-icon"></i>
                        <input asp-for="DataVend" type="date" class="form-control-custom" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="DataVend" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade Vendida</label>
                    <div class="input-group-custom">
                        <i class="bi bi-hash text-salmon input-icon"></i>
                        <input asp-for="QtdVendida" type="number" step="1" min="1" class="form-control-custom font-monospace" placeholder="Ex: 5" />
                    </div>
                    <span asp-validation-for="QtdVendida" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Receita / Produto</label>
                    <div class="input-group-custom">
                        <i class="bi bi-receipt text-salmon input-icon"></i>
                        <select asp-for="IdReceita" class="form-select-custom" asp-items="@Model.ListaReceitas">
                            <option value="">-- Selecione o Prato/Produto --</option>
                        </select>
                    </div>
                    <div class="form-text text-muted mt-1" style="font-size: 11px;">
                        <i class="bi bi-lightning-charge text-warning"></i> A seleção dará baixa automática nos insumos vinculados a esta receita.
                    </div>
                    <span asp-validation-for="IdReceita" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm"><i class="bi bi-check-lg me-1"></i> Confirmar Venda</button>
            </div>
        </form>
    </div>
</div>

