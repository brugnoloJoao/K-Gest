@model K_Gest.Models.HistoricoVendasViewModel;

@{
    ViewData["Title"] = "Excluir Registro de Venda";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para o histórico
        </a>
    </div>

    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-danger">
            <i class="bi bi-trash3-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Excluir Registro de Venda</h2>
            <p class="text-muted small m-0 mt-1">Confirme os detalhes abaixo antes de prosseguir com a exclusão definitiva</p>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #fffbeb; color: #b45309; border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div class="fw-medium small"><strong>Atenção:</strong> Esta ação não poderá ser desfeita. A exclusão deste histórico pode impactar o recálculo do estoque dos insumos.</div>
    </div>

    <div class="card border-0 shadow-premium" style="border-radius: 20px; background: #ffffff; padding: 24px;">
        <form asp-action="ExcluirProcessar" method="post">

            <input type="hidden" asp-for="IdVendas" />

            <h5 class="text-dark fw-bold mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-info-circle me-1 text-secondary"></i> Dados do Registro Selecionado
            </h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Data da Venda</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar3 text-secondary input-icon"></i>
                        <input asp-for="DataVend" type="date" class="form-control-custom" disabled />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Quantidade Vendida</label>
                    <div class="input-group-custom">
                        <i class="bi bi-hash text-secondary input-icon"></i>
                        <input asp-for="QtdVendida" type="number" class="form-control-custom font-monospace" disabled />
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Receita / Produto</label>
                    <div class="input-group-custom">
                        <i class="bi bi-receipt text-secondary input-icon"></i>
                        <select asp-for="IdReceita" class="form-select-custom" asp-items="@Model.ListaReceitas" disabled>
                            <option value="">-- Selecione o Prato/Produto --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-delete shadow-sm">
                    <i class="bi bi-trash3 me-1"></i> Excluir Definitivamente
                </button>
            </div>
        </form>
    </div>
</div>

