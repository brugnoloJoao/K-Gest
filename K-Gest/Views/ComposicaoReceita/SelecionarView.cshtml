@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Gestão de Fichas Técnicas";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0 page-title">Gestão de Fichas Técnicas</h2>
                <p class="text-muted small m-0 mt-1">Configure as composições de insumos e rendimentos para cada prato</p>
            </div>
        </div>

        @* O botão de Nova Composição só faz sentido ficar ativo se houverem pratos *@
        @if (Model != null && Model.Rows.Count > 0)
        {
            <a href="/ComposicaoReceita/InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i> Nova Composição
            </a>
        }
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4 alert-success-feedback" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 alert-danger-feedback" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    @if (Model == null || Model.Rows.Count == 0)
    {
        <div class="card border-0 shadow-premium py-5 text-center card-section">
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-4 empty-icon-circle">
                    <i class="bi bi-egg-fried icon-size-xl" ></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Nenhum prato disponível</h4>
                <p class="text-muted mx-auto mb-4 empty-desc-sm">
                    Para criar uma composição ou ficha técnica, você precisa ter pelo menos uma receita cadastrada no sistema.
                </p>
                <a href="/Receitas/InserirExibir" class="btn-salmon-action d-inline-flex align-items-center gap-2 px-4 py-2.5 shadow-sm">
                    <i class="bi bi-plus-circle"></i> Cadastrar meu Primeiro Prato
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-premium card-section">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 700px;">
                    <thead class="table-head-default">
                        <tr>
                            <th class= th-col-label"ps-4 py-3 text-secondary text-uppercase fw-bold">Receita (Prato)</th>
                            <th class= th-col-label"py-3 text-secondary text-uppercase fw-bold text-center" style="width: 250px;">Ingredientes</th>
                            <th class= th-col-label"pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="width: 120px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        @foreach (DataRow dr in Model.Rows)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="fw-semibold text-dark fs-6 d-block">@dr["nomePrato"]</span>
                                </td>

                                <td class="text-center py-3">
                                    <button class="btn-action-pill btn-view-salmon d-inline-flex align-items-center gap-2"
                                            onclick="verIngredientes(@dr["idReceita"], '@dr["nomePrato"]')">
                                        <i class="bi bi-search"></i> Visualizar Insumos
                                    </button>
                                </td>

                                <td class="pe-4 text-center py-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/ComposicaoReceita/EditarFicha/@dr["idReceita"]"
                                           class="btn-action-modern btn-edit-salmon"
                                           title="Editar Ficha Técnica">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalIngredientes" tabindex="-1" aria-labelledby="modalIngredientesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden; ">
            <div class="modal-header px-4 pt-4 pb-3 border-0 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white flex-shrink-0" style="background-color: #ff8c69; width: 40px; height: 40px; font-size: 18px; box-shadow: 0 4px 12px rgba(255, 140, 105, 0.25);">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark lh-sm m-0" id="modalIngredientesLabel" style="font-size: 20px;">Ingredientes</h5>
                        <span id="tituloReceita" class="text-muted small fw-semibold d-block mt-0.5" style="font-size: 13px;"></span>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close" style="font-size: 12px;"></button>
            </div>

            <div class="modal-body p-0 px-4 pb-2 modal-body-scrollable">
                <div id="listaItens" class="list-group list-group-flush">
                    <div class="text-center py-5">
                        <div class="spinner-border text-secondary mb-3" role="status" style="width: 2rem; height: 2rem; --bs-spinner-border-width: 3px; color: var(--salmon-primary) !important;"></div>
                        <p class="small text-muted m-0">Carregando ingredientes da receita...</p>
                    </div>
                </div>
            </div>

            <div class="modal-footer px-4 py-3 border-top">
                <button type="button" class="btn btn-light border fw-semibold text-secondary px-4 py-2" data-bs-dismiss="modal" style="border-radius: 12px; font-size: 13.5px; transition: all 0.2s;">Fechar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function verIngredientes(id, nome) {
            document.getElementById('tituloReceita').innerText = nome;

            var modalEl = document.getElementById('modalIngredientes');
            var modalBootstrap = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalBootstrap.show();

            document.getElementById('listaItens').innerHTML = `
                        <div class="text-center py-5">
                            <div class="spinner-border mb-3" role="status" style="width: 2rem; height: 2rem; --bs-spinner-border-width: 3px; color: var(--salmon-primary);"></div>
                            <p class="small text-muted m-0">Carregando ingredientes da receita...</p>
                        </div>`;

            fetch('/ComposicaoReceita/ObterIngredientesJson/' + id)
                .then(response => response.json())
                .then(data => {
                    let html = '';

                    if (data.length === 0) {
                        html = `
                                    <div class="p-5 text-center text-muted">
                                        <i class="bi bi-inboxes d-block fs-2 mb-2 text-secondary opacity-50"></i>
                                        <span class="small fw-medium">Nenhum ingrediente cadastrado nesta ficha técnica.</span>
                                    </div>`;
                    } else {
                        data.forEach(item => {
                            html += `
                                        <div class="d-flex justify-content-between align-items-center py-3 modal-list-item">
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark fs-6">${item.nomeInsumo}</h6>
                                                <span class="badge font-monospace px-2.5 py-1.5 border border-0" style="border-radius: 8px; font-size: 12px; background-color: #fff1ed; color: #ff5742; font-weight: 700; letter-spacing: 0.3px;">
                                                    ${item.qtdEx} ${item.unidadeEx}
                                                </span>
                                            </div>
                                            <a href="/ComposicaoReceita/ExcluirIngrediente/${item.idComp}"
                                               class="btn-action-modern border-0 text-danger bg-danger-subtle"
                                               style="border-radius: 8px; width: 32px; height: 32px; background-color: #fef2f2 !important;"
                                               onclick="return confirm('Deseja realmente remover ${item.nomeInsumo} desta receita?')">
                                                <i class="bi bi-trash3-fill" style="font-size: 13px;"></i>
                                            </a>
                                        </div>`;
                        });
                    }
                    document.getElementById('listaItens').innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('listaItens').innerHTML =
                        '<div class="alert alert-danger border-0 m-3 small fw-medium text-center" style="border-radius: 10px;">Ocorreu um erro inesperado ao carregar os dados.</div>';
                });
        }
    </script>
}