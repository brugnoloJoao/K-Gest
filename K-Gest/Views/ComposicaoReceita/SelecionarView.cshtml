@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Composição das Receitas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ingredientes por Receita</h2>
        <a asp-action="InserirExibir" class="btn btn-success">Adicionar Ingrediente</a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success">@TempData["MsgSucesso"]</div>
    }

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Receita (Prato)</th>
                <th>Insumo (Ingrediente)</th>
                <th class="text-end">Qtd. Necessária</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["NomePrato"]</td>
                    <td>@row["NomeInsumo"]</td>
                    <td class="text-end">@Convert.ToDecimal(row["QtdNecessaria"]).ToString("N2")</td>
                    <td class="text-center">
                        <a asp-action="AlterarExibir" asp-route-idComposicao="@row["idComposicao"]" class="btn btn-primary">Editar</a>
                        <a asp-action="ExcluirExibir" asp-route-idComposicao="@row["idComposicao"]" class="btn btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>