@model K_Gest.Models.ComposicaoReceitaViewModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4><i class="bi bi-list-check"></i> Montar Ficha Técnica</h4>
        </div>
        <div class="card-body">
            <form id="frmFicha" action="@(Model.IdReceita > 0 ? "/ComposicaoReceita/AlterarProcessar" : "/ComposicaoReceita/InserirProcessar")" method="post">

                <input type="hidden" asp-for="IdReceita" id="hdnIdReceita" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Receita</label>
                    <select id="selReceita" asp-items="Model.ListaReceitas" class="form-select border-primary" style="@(Model.IdReceita > 0 ? "pointer-events: none; background-color: #e9ecef;" : "")">
                        <option value="">-- Escolha o Prato --</option>
                    </select>
                    @if (Model.IdReceita > 0)
                    {
                        <small class="text-muted">Para mudar o prato, crie uma nova ficha.</small>
                    }
                </div>

                <div class="bg-light p-3 border rounded mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Ingrediente</label>
                            <select id="selInsumo" class="form-select">
                                <option value="">-- Selecione --</option>
                                @foreach (var item in Model.ListaInsumos)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantidade</label>
                            <input type="number" id="txtQtd" class="form-control" step="0.001" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnAdd" class="btn btn-success w-100">Incluir</button>
                        </div>
                    </div>
                </div>

                <table class="table table-striped border" id="tblItens">
                    <thead class="table-dark">
                        <tr>
                            <th>Ingrediente</th>
                            <th>Quantidade</th>
                            <th>Unidade Original</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Itens != null)
                        {
                            for (int i = 0; i < Model.Itens.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.Itens[i].NomeInsumo
                                        <input type="hidden" class="insumo-id" value="@Model.Itens[i].IdInsumo" />
                                    </td>
                                    <td>
                                        @Model.Itens[i].Quantidade.ToString("G29")
                                        <input type="hidden" class="insumo-qtd" value="@Model.Itens[i].Quantidade.ToString().Replace(",", ".")" />
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@Model.Itens[i].UnidadeMed</span>
                                        <input type="hidden" class="insumo-unidade" value="@Model.Itens[i].UnidadeMed" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger btn-remover">Remover</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Salvar Ficha Técnica</button>
                <a asp-action="Selecionar" class="btn btn-outline-secondary w-100 mt-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sincroniza o select inicial com o input hidden do IdReceita
        const selReceita = document.getElementById('selReceita');
        const hdnIdReceita = document.getElementById('hdnIdReceita');

        if (selReceita && hdnIdReceita && hdnIdReceita.value) {
            selReceita.value = hdnIdReceita.value;
        }

        selReceita.addEventListener('change', function () {
            hdnIdReceita.value = this.value;
        });

        // Evento para tratar botão incluir
        document.getElementById('btnAdd').addEventListener('click', function () {
            const sel = document.getElementById('selInsumo');
            const qtd = document.getElementById('txtQtd');

            if (!sel.value || !qtd.value) return;

            const idInsumo = sel.value;
            const textoCombo = sel.options[sel.selectedIndex].text;

            const unidade = textoCombo.substring(textoCombo.lastIndexOf("(") + 1, textoCombo.lastIndexOf(")"));
            const nomeInsumo = textoCombo.split(' (')[0];

            const tbody = document.querySelector('#tblItens tbody');
            const tr = document.createElement('tr');

            tr.innerHTML = `
                        <td>
                            ${nomeInsumo}
                            <input type="hidden" class="insumo-id" value="${idInsumo}" />
                        </td>
                        <td>
                            ${qtd.value}
                            <input type="hidden" class="insumo-qtd" value="${qtd.value}" />
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">${unidade}</span>
                            <input type="hidden" class="insumo-unidade" value="${unidade}" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger btn-remover">Remover</button>
                        </td>
                    `;

            tbody.appendChild(tr);

            sel.value = "";
            qtd.value = "";
        });

        // Evento delegado para o botão remover que funciona em elementos criados dinamicamente
        document.querySelector('#tblItens tbody').addEventListener('click', function (e) {
            if (e.target && e.target.classList.contains('btn-remover')) {
                e.target.closest('tr').remove();
            }
        });

        // --- SOLUÇÃO CRÍTICA DO BOTÃO SALVAR (REORGANIZAÇÃO DOS ÍNDICES ANTES DE ENVIAR) ---
        document.getElementById('frmFicha').addEventListener('submit', function (e) {
            const linhas = document.querySelectorAll('#tblItens tbody tr');

            linhas.forEach((tr, index) => {
                const inputId = tr.querySelector('.insumo-id');
                const inputQtd = tr.querySelector('.insumo-qtd');
                const inputUnidade = tr.querySelector('.insumo-unidade');

                // Força o name correto sequencial ex: Itens[0], Itens[1]... independente de exclusões
                inputId.name = `Itens[${index}].IdInsumo`;
                inputQtd.name = `Itens[${index}].Quantidade`;
                inputUnidade.name = `Itens[${index}].UnidadeMed`;
            });
        });
    </script>
}