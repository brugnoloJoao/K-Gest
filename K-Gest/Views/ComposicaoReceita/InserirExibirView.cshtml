@model K_Gest.Models.ComposicaoReceitaViewModel

@{
    ViewData["Title"] = "Montar Ficha Técnica";
}

<div class="container-fluid px-4 py-4 container-max-1000">

    @* Navegação de Retorno *@
    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para a lista
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-list-check"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Montar Ficha Técnica</h2>
            <p class="text-muted small m-0 mt-1">Combine os insumos e monte as proporções da receita do prato.</p>
        </div>
    </div>

    @* Card Principal *@
    <div class="card border-0 shadow-premium card-section">
        <div class="card-body p-4 p-md-5">
            <form id="frmFicha" action="@(Model.IdReceita > 0 ? "/ComposicaoReceita/AlterarProcessar" : "/ComposicaoReceita/InserirProcessar")" method="post">

                <input type="hidden" asp-for="IdReceita" id="hdnIdReceita" />

                @* Seção: Seleção da Receita *@
                <div class="mb-5">
                    <label class="form-select-custom border-0 bg-transparent py-1 shadow-none fw-bold text-dark fs-6">Receita / Prato</label>
                    <div class="modern-input-group">
                        <i class="bi bi-journal-bookmark-fill text-salmon"></i>
                        <select id="selReceita" asp-items="Model.ListaReceitas" class="form-select-modern" style="@(Model.IdReceita > 0 ? "pointer-events: none; background-color: #f1f5f9; color: #94a3b8;" : "")">
                            <option value=""> Escolha o Prato </option>
                        </select>
                    </div>
                    @if (Model.IdReceita > 0)
                    {
                        <div class="form-text text-muted mt-2 small d-flex align-items-center gap-1">
                            <i class="bi bi-info-circle"></i> Para mudar o prato, crie uma nova ficha técnica.
                        </div>
                    }
                </div>
                @* Seção Adicionar Ingrediente (Sub-Card Interno) *@
                <div class="p-4 border rounded-4 mb-5">
                    <h5 class="fw-bold text-dark mb-4" style="font-size: 16px;"><i class="bi bi-plus-circle-fill text-salmon me-2"></i>Adicionar Ingrediente à Ficha</h5>

                    <div class="row g-4 align-items-end">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label text-secondary fw-bold xs-uppercase">Ingrediente</label>
                            <div class="modern-input-group">
                                <i class="bi bi-tag-fill text-salmon"></i>
                                <select id="selInsumo" class="form-select-modern">
                                    <option value="">Selecione </option>
                                    @foreach (var item in Model.ListaInsumos)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label text-secondary fw-bold xs-uppercase">Quantidade</label>
                            <div class="modern-input-group">
                                <i class="bi bi-calculator text-salmon"></i>
                                <input type="number" id="txtQtd" class="form-control-modern font-monospace" step="0.001" placeholder="0,000" />
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label text-secondary fw-bold xs-uppercase">Unidade de Medida</label>
                            <div class="modern-input-group">
                                <i class="bi bi-box-seam-fill text-salmon"></i>
                                <select id="selUni" class="form-select-modern">
                                    <option value="">-- Selecione --</option>
                                    <option value="KG">Quilograma (KG)</option>
                                    <option value="UN">Unidade (UN)</option>
                                    <option value="L">Litro (L)</option>
                                    <option value="G">Grama (G)</option>
                                    <option value="ML">Mililitro (ML)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <button type="button" id="btnAdd" class="btn-salmon-action w-100" style="padding: 12px 0;">
                                <i class="bi bi-plus-lg"></i> Incluir
                            </button>
                        </div>
                    </div>
                </div>
                @* Tabela de Itens *@
                <div class="table-responsive rounded-4 border mb-4 border-light-custom">
                    <table class="table table-modern align-middle mb-0" id="tblItens">
                        <thead>
                            <tr>
                                <th>Ingrediente</th>
                                <th>Quantidade</th>
                                <th>Unidade</th>
                                <th class="text-center" style="width: 100px;">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Itens != null)
                            {
                                for (int i = 0; i < Model.Itens.Count; i++)
                                {
                                    <tr data-origem="banco">
                                        <td class="fw-semibold text-dark">
                                            @Model.Itens[i].NomeInsumo
                                            <input type="hidden" class="insumo-id" value="@Model.Itens[i].IdInsumo" />
                                        </td>
                                        <td class="font-monospace fw-bold text-secondary">
                                            @Model.Itens[i].QuantidadeExibicao.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)
                                            <input type="hidden" class="insumo-qtd" value="@Model.Itens[i].Quantidade.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)" />
                                        </td>
                                        <td>
                                            <span class="badge badge-salmon-soft">@Model.Itens[i].UnidadeExibicao</span>
                                            <input type="hidden" class="insumo-unidade" value="@Model.Itens[i].UnidadeExibicao" />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn-delete-modern btn-remover">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @* Rodapé de Ações do Formulário *@
                <div class="row g-3 mt-4">
                    <div class="col-md-8">
                        <button type="submit" class="btn-salmon-action w-100 shadow-sm">
                            <i class="bi bi-cloud-check-fill me-2"></i> Salvar Ficha Técnica
                        </button>
                    </div>
                    <div class="col-md-4">
                        <a asp-action="Selecionar" class="btn-cancel-modern w-100 d-block text-center">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        const selReceita = document.getElementById('selReceita');
        const hdnIdReceita = document.getElementById('hdnIdReceita');

        if (selReceita && hdnIdReceita && hdnIdReceita.value) {
            selReceita.value = hdnIdReceita.value;
        }

        selReceita.addEventListener('change', function () {
            hdnIdReceita.value = this.value;
        });

        // --- VALIDAÇÃO DE GRANDEZAS FÍSICAS ---
        const selInsumo = document.getElementById('selInsumo');
        const selUni = document.getElementById('selUni');

        // Mapeamento de grupos de grandezas equivalentes
        const gruposGrandezas = {
            'KG': ['KG', 'G'],
            'G':  ['KG', 'G'],
            'L':  ['L', 'ML'],
            'ML': ['L', 'ML'],
            'UN': ['UN']
        };

        selInsumo.addEventListener('change', function () {
            const opcaoSelecionada = this.options[this.selectedIndex].text;

            // Restaura o select de unidades antes de filtrar
            Array.from(selUni.options).forEach(opt => {
                opt.disabled = false;
                opt.style.display = 'block';
            });
            selUni.value = ""; // Limpa seleção anterior

            if (!this.value) return;

            // Captura o que está dentro dos últimos parênteses do texto do insumo (ex: "Arroz (KG)" -> "KG")
            const match = opcaoSelecionada.match(/\(([^)]+)\)[^()]*$/);
            if (!match) return;

            const unidadePadraoInsumo = match[1].toUpperCase();
            const unidadesPermitidas = gruposGrandezas[unidadePadraoInsumo] || [unidadePadraoInsumo];

            // Filtra as opções do select de unidades
            Array.from(selUni.options).forEach(opt => {
                if (opt.value === "") return; // Ignora o "-- Selecione --"

                if (!unidadesPermitidas.includes(opt.value.toUpperCase())) {
                    opt.disabled = true;
                    opt.style.display = 'none'; // Esconde visualmente no Chrome/Firefox
                }
            });

            // Se houver apenas uma opção possível (ex: UN), já seleciona automaticamente
            const opcionaisVisiveis = Array.from(selUni.options).filter(opt => !opt.disabled && opt.value !== "");
            if (opcionaisVisiveis.length === 1) {
                selUni.value = opcionaisVisiveis[0].value;
            }
        });


        // Incluir novos itens manualmente na tabela
        document.getElementById('btnAdd').addEventListener('click', function () {
            const selIns = document.getElementById('selInsumo');
            const qtd = document.getElementById('txtQtd');
            const selUni = document.getElementById('selUni');
            if (!selIns.value || !qtd.value || !selUni.value) return;

            const idInsumo = selIns.value;

            // Remove a unidade do texto para salvar um nome limpo na tabela se preferir
            let nomeInsumo = selIns.options[selIns.selectedIndex].text;
            nomeInsumo = nomeInsumo.replace(/\s*\([^)]+\)\s*$/, '');

            const unidade = selUni.options[selUni.selectedIndex].value; // Pega direto o Value (KG, G, L...)

            const tbody = document.querySelector('#tblItens tbody');
            const tr = document.createElement('tr');
            tr.setAttribute('data-origem', 'tela');

            let qtdDigitada = qtd.value.replace('.', ',');

            tr.innerHTML = `
                <td class="fw-semibold text-dark">
                    ${nomeInsumo}
                    <input type="hidden" class="insumo-id" value="${idInsumo}" />
                </td>
                <td class="font-monospace fw-bold text-secondary">
                    ${qtdDigitada}
                    <input type="hidden" class="insumo-qtd" value="${qtd.value}" />
                </td>
                <td>
                    <span class="badge badge-salmon-soft">${unidade}</span>
                    <input type="hidden" class="insumo-unidade" value="${unidade}" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn-delete-modern btn-remover">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);

            selIns.value = "";
            selUni.value = "";
            qtd.value = "";

            // Reseta o estado do select de unidades
            Array.from(selUni.options).forEach(opt => {
                opt.disabled = false;
                opt.style.display = 'block';
            });
        });

        // Remover linhas da tabela (Event Delegation)
        document.getElementById('tblItens').addEventListener('click', function (e) {
            if (e.target && e.target.closest('.btn-remover')) {
                e.target.closest('tr').remove();
            }
        });

        // Processamento ao clicar em Salvar Ficha Técnica
        document.getElementById('frmFicha').addEventListener('submit', function (e) {
            const lines = document.querySelectorAll('#tblItens tbody tr');

            lines.forEach((tr, index) => {
                const inputId = tr.querySelector('.insumo-id');
                const inputQtd = tr.querySelector('.insumo-qtd');
                const inputUnidade = tr.querySelector('.insumo-unidade');

                let valorTexto = inputQtd.value.replace(',', '.');
                let valorFinal = parseFloat(valorTexto);

                const unidadeTexto = inputUnidade.value.toUpperCase();
                const origen = tr.getAttribute('data-origem');

                // Conversão de grandezas para a unidade base (multiplica por 1000 se for KG ou L)
                if (origen === "tela" && (unidadeTexto === "KG" || unidadeTexto === "L")) {
                    valorFinal = valorFinal * 1000;
                }

                inputId.name = `Itens[${index}].IdInsumo`;
                inputQtd.name = `Itens[${index}].Quantidade`;
                inputUnidade.name = `Itens[${index}].UnidadeExibicao`;

                inputQtd.value = valorFinal.toString();
            });
        });
    </script>
}