@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Lista de Receitas";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-shape-salmon">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark m-0" style="font-size: 24px; letter-spacing: -0.5px;">Pratos</h2>
                <p class="text-muted small m-0 mt-1">Gerencie o cardápio e a ficha técnica dos pratos cadastrados</p>
            </div>
        </div>
        <a asp-action="InserirExibir" class="btn-salmon-action d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Nova Receita
        </a>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-radius: 12px;">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgSucesso"]</div>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" style="background-color: #fef2f2; color: #991b1b; border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-medium small">@TempData["MsgErro"]</div>
        </div>
    }

    <div class="card border-0 shadow-premium" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 600px;">
                <thead style="background-color: #f8fafc; border-bottom: 2px solid #f1f5f9;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px; width: 100px;">ID</th>
                        <th class="py-3 text-secondary text-uppercase fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Nome do Prato</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-bold text-center" style="font-size: 11px; letter-spacing: 0.5px; width: 150px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    @foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <span class="badge bg-light text-secondary border px-2 py-1.5 font-monospace" style="border-radius: 6px; font-size: 12px;">
                                    #@row["idReceita"]
                                </span>
                            </td>

                            <td class="py-3">
                                <span class="fw-semibold text-dark fs-6 d-block">@row["nomePrato"]</span>
                            </td>

                            <td class="pe-4 text-center py-3">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="AlterarExibir"
                                       asp-route-idReceita="@row["idReceita"]"
                                       class="btn-action-modern btn-edit-salmon"
                                       title="Editar Receita">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="ExcluirExibir"
                                       asp-route-idReceita="@row["idReceita"]"
                                       class="btn-action-modern btn-delete-salmon"
                                       title="Excluir Receita">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
