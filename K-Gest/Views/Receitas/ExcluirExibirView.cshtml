@model K_Gest.Models.ReceitasViewModel

@{
    ViewData["Title"] = "Excluir Receita";
}

<div class="container-fluid px-4 py-4" style="max-width: 700px; margin: 0 auto;">

    @* Topo de Navegação *@
    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para a Listagem
        </a>
    </div>

    @* Alerta de Atenção Premium Customizado *@
    <div class="alert alert-danger-custom border-0 shadow-sm d-flex align-items-start gap-3 mb-4 p-4">
        <div class="icon-shape-danger-alert flex-shrink-0">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>
        <div>
            <h4 class="fw-bold m-0" style="font-size: 18px; letter-spacing: -0.3px;">Atenção! Remover Ficha Técnica</h4>
            <p class="small m-0 mt-1 opacity-90">Você está prestes a excluir permanentemente a receita de <strong>@Model.NomePrato</strong>. Certifique-se de que nenhum cardápio ativo ou histórico dependa diretamente desta estrutura antes de prosseguir.</p>
        </div>
    </div>

    @* Card de Detalhes da Receita *@
    <div class="card border-0 shadow-premium card-toggle" style="border-radius: 20px; overflow: hidden; ">
        <div class="card-header border-0 bg-transparent pt-4 px-4 pb-2">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 bg-light rounded-3 text-dark d-inline-flex border icon-table-toggle">
                    <i class="bi bi-journal-text fs-5"></i>
                </span>
                <div>
                    <h5 class="fw-bold text-dark m-0 var-text-color">Confirmar Dados do Prato</h5>
                    <p class="text-muted small m-0 sub-text-toggle">Valide a receita selecionada para exclusão</p>
                </div>
            </div>
        </div>

        <div class="card-body px-4 pb-4 pt-3">
            <div class="bg-light p-3 rounded-3 mb-4 border" style="background-color: #f8fafc !important;">
                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-secondary small text-uppercase fw-bold sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px;">Código (ID)</dt>
                    <dd class="col-sm-8 fw-mono text-dark var-text-color mb-0">#@Model.IdReceita</dd>

                    <dt class="col-sm-4 text-secondary small text-uppercase fw-bold sub-text-toggle" style="font-size: 11px; letter-spacing: 0.5px;">Nome do Prato</dt>
                    <dd class="col-sm-8 fw-bold text-dark var-text-color mb-0 fs-6">@Model.NomePrato</dd>
                </dl>
            </div>

            @* Formulário de Envio Seguro *@
            <form asp-action="ExcluirProcessar" method="post">
                @* Token de ID oculto para binding correto no controller da Kantine *@
                <input type="hidden" asp-for="IdReceita" />

                <div class="d-flex align-items-center justify-content-end gap-3 flex-wrap">
                    <a asp-action="Selecionar" class="btn-cancel-action d-inline-flex align-items-center gap-2">
                        Cancelar
                    </a>
                    <button type="submit" class="btn-danger-premium d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-trash3-fill"></i> Excluir Receita
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

