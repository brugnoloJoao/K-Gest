@model K_Gest.Models.ReceitasViewModel

@{
    ViewData["Title"] = "Editar Receita";
}

<div class="container-fluid px-4 py-4 container-max-900">

    @* Navegação de Retorno *@
    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-chevron-left"></i> Voltar para a lista
        </a>
    </div>

    @* Cabeçalho da Página *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-pencil-fill"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 page-title">Alterar Receita</h2>
            <p class="text-muted small m-0 mt-1">Atualize o nome, preço e as especificações do prato selecionado.</p>
        </div>
    </div>

    @* Card do Formulário *@
    <div class="card border-0 shadow-premium card-section">
        <div class="card-body p-4 p-md-5">
            <form asp-action="AlterarProcessar" method="post">
                @* CAMPO OBRIGATÓRIO PARA O UPDATE *@
                <input type="hidden" asp-for="IdReceita" />

                <div class="row g-4">
                    @* Nome do Prato *@
                    <div class="col-12">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Nome do Prato</label>
                        <div class="modern-input-group">
                            <i class="bi bi-journal-bookmark-fill text-salmon"></i>
                            <input asp-for="NomePrato" class="form-control-modern" placeholder="Ex: Estrogonofe de Frango" required />
                        </div>
                        <span asp-validation-for="NomePrato" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Preço do Prato *@
                    <div class="col-12">
                        <label class="form-label text-secondary fw-bold small text-uppercase">Preço</label>
                        <div class="modern-input-group">
                            <i class="bi bi-currency-dollar text-salmon"></i>
                            <input asp-for="Preco" type="text" class="form-control-modern" placeholder="Ex: 35,90" required />
                        </div>
                        <span asp-validation-for="Preco" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Rodapé de Ações *@
                    <div class="col-12 mt-5 d-flex gap-2">
                        <button type="submit" class="btn-salmon-action flex-grow-1 shadow-sm">
                            <i class="bi bi-cloud-check-fill me-2"></i> Salvar Alterações
                        </button>
                        <a asp-action="Selecionar" class="btn-cancel-modern">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>