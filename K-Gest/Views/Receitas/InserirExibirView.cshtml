@model K_Gest.Models.ReceitasViewModel

@{
    ViewData["Title"] = "Nova Receita";
}

<div class="container-fluid px-4 py-4" style="max-width: 1000px; margin: 0 auto;">

    @* Topo de Navegação *@
    <div class="mb-3">
        <a asp-action="Selecionar" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1 back-link">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

    @* Cabeçalho Premium *@
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="icon-shape-salmon">
            <i class="bi bi-journal-plus"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0 var-text-color" style="font-size: 24px; letter-spacing: -0.5px;">Cadastrar Nova Receita</h2>
            <p class="text-muted small m-0 mt-1 sub-text-toggle">Monte o cabeçalho do prato para posteriormente associar a sua composição de insumos</p>
        </div>
    </div>

    @* Card Formulário Principal *@
    <div class="card border-0 shadow-premium card-toggle" style="border-radius: 20px;  padding: 24px;">
        <form asp-action="InserirProcessar" method="post">

            <h5 class="text-dark fw-bold mb-4 pb-2" style="font-size: 15px; border-bottom: 2px solid #f1f5f9;">
                <i class="bi bi-egg-fried me-1 text-salmon"></i> Identificação do Prato
            </h5>

            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold small mb-2 text-uppercase">Nome do Prato / Ficha Técnica</label>
                    <div class="input-group-custom">
                        <i class="bi bi-blockquote-left text-salmon input-icon"></i>
                        <input asp-for="NomePrato" class="form-control-custom" placeholder="Ex: Lasanha Bolonhesa Especial, Suco de Laranja 300ml" />
                    </div>
                    <span asp-validation-for="NomePrato" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            @* Seções futuras podem ser acopladas aqui (Ex: Categoria, Preço, Tempo de Preparo) *@

            @* Ações de Envio *@
            <div class="d-flex justify-content-end align-items-center gap-2 mt-5 pt-3" style="border-top: 1px solid #f1f5f9;">
                <a asp-action="Selecionar" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Salvar Receita
                </button>
            </div>
        </form>
    </div>
</div>