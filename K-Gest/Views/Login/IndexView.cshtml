@model K_Gest.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Kantine Gastronomia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

        <link rel="stylesheet" href="~/css/k-gest-login.css" />
</head>
<body class="d-flex align-items-center justify-content-center">

    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="container login-container">
        <div class="row justify-content-center">
            @* Adicionado 'col-12' para ocupar toda a largura em telas minúsculas *@
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">

                @* Modificado para usar padding responsivo (p-3 no mobile e p-sm-5 no desktop) *@
                <div class="card login-card p-3 p-sm-4 border-0">
                    <div class="card-body p-0">

                        <div class="text-center mb-4">
                            <div class="logo-wrapper mb-3">
                                <img src="~/imagens/logoKant.webp" alt="Kantine Gastronomia" class="logo-img" />
                            </div>
                            <div class="system-subtitle mt-1">
                                Controle de Fichas & Estoque
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert custom-alert py-3 small d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                <div>@ViewBag.Erro</div>
                            </div>
                        }

                        <form asp-controller="Login" asp-action="Autenticar" method="post">

                            <div class="mb-3 form-group-container">
                                <label class="form-label fw-bold">Usuário</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" asp-for="Usuario" class="form-control" placeholder="Digite seu usuário" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Usuario" class="text-danger small d-block mt-1" style="font-size: 0.73rem; padding-left: 4px;"></span>
                            </div>

                            <div class="mb-4 form-group-container">
                                <label class="form-label fw-bold">Senha</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" asp-for="Senha" class="form-control" placeholder="Digite sua senha" />
                                </div>
                                <span asp-validation-for="Senha" class="text-danger small d-block mt-1" style="font-size: 0.73rem; padding-left: 4px;"></span>
                            </div>

                            <button type="submit" class="btn btn-kantine w-100 mb-3">
                                Entrar no sistema <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
                            </button>

                            <div class="or-divider mb-3">ou</div>

                            <a asp-controller="Login" asp-action="Cadastrar" class="btn-kantine-outline w-100">
                                <i class="bi bi-person-plus me-2 fs-5"></i> Criar Nova Conta
                            </a>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>