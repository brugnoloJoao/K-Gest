@model K_Gest.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Kantine Gastronomia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
            :root {
                --bg-light: #f4f5f7;
                --accent-salmon-strong: #ff5742;
                --accent-coral-vibrant: #ff3355;
                --brand-grey: #4d4d4d;
                --text-main: #2d292a;
                --text-muted: #7d6f70;
                --glass-bg: rgba(255, 255, 255, 0.65);
                --glass-border: rgba(255, 87, 66, 0.12);
            }

            body {
                background-color: var(--bg-light);
                background-image: radial-gradient(circle at 80% 20%, rgba(255, 87, 66, 0.15) 0%, transparent 50%), radial-gradient(circle at 15% 80%, rgba(77, 77, 77, 0.08) 0%, transparent 50%);
                min-height: 100vh;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                overflow: hidden;
                position: relative;
                color: var(--text-main);
            }

            /* Luzes Flutuantes de Fundo */
            .bg-glow-1, .bg-glow-2 {
                position: absolute;
                border-radius: 50%;
                filter: blur(120px);
                z-index: 0;
                pointer-events: none;
            }

            .bg-glow-1 {
                width: 450px;
                height: 450px;
                background: rgba(255, 87, 66, 0.14);
                top: 20%;
                left: -10%;
                animation: floatGlow 15s ease-in-out infinite alternate;
            }

            .bg-glow-2 {
                width: 550px;
                height: 550px;
                background: rgba(255, 51, 85, 0.09);
                bottom: 10%;
                right: -5%;
                animation: floatGlow 20s ease-in-out infinite alternate-reverse;
            }

            .login-container {
                position: relative;
                z-index: 1;
                perspective: 1000px;
            }

            /* Card Light Glassmorphism Premium */
            .login-card {
                background: var(--glass-bg);
                backdrop-filter: blur(30px);
                -webkit-backdrop-filter: blur(30px);
                border: 1px solid var(--glass-border);
                border-radius: 28px;
                box-shadow: 0 25px 55px rgba(45, 41, 42, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.6);
                opacity: 0;
                transform: translateY(40px) scale(0.98);
                animation: cardEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation-delay: 0.1s;
            }

            /* Logo e Cabeçalho */
            .logo-wrapper {
                padding: 12px 24px;
                background: rgba(255, 255, 255, 0.5);
                border: 1px solid rgba(255, 255, 255, 0.8);
                border-radius: 20px;
                display: inline-block;
                max-width: 100%;
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
                opacity: 0;
                transform: scale(0.9);
                animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
                animation-delay: 0.3s;
            }

            .logo-img {
                max-width: 100%;
                height: auto;
                max-height: 70px;
                object-fit: contain;
                transition: transform 0.5s ease;
            }

            .logo-wrapper:hover .logo-img {
                transform: scale(1.03);
            }

            .system-subtitle {
                letter-spacing: 2px;
                text-transform: uppercase;
                font-size: 0.68rem;
                color: var(--text-muted);
                font-weight: 600;
                opacity: 0;
                animation: fadeIn 0.8s ease forwards;
                animation-delay: 0.5s;
            }

            /* Labels e Inputs */
            .form-label {
                font-size: 0.75rem;
                letter-spacing: 0.8px;
                text-transform: uppercase;
                color: var(--text-muted) !important;
                font-weight: 600;
                margin-bottom: 0.5rem;
                transition: color 0.3s ease;
            }

            .input-group {
                background: rgba(255, 255, 255, 0.6);
                border: 1px solid rgba(0, 0, 0, 0.08);
                border-radius: 16px !important;
                transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                overflow: hidden;
            }

            .input-group-text {
                background: transparent;
                border: none;
                color: var(--text-muted);
                padding-left: 1.2rem;
                transition: color 0.3s ease;
            }

            .form-control {
                background: transparent;
                border: none;
                color: var(--text-main);
                padding: 0.85rem 1.2rem 0.85rem 0.5rem;
                font-size: 0.95rem;
                font-weight: 500;
            }

                .form-control:focus {
                    background: transparent;
                    box-shadow: none;
                    color: var(--text-main);
                }

                .form-control::placeholder {
                    color: #aba0a1;
                    transition: opacity 0.3s ease;
                }

            /* Foco Neon */
            .input-group:focus-within {
                border-color: var(--accent-salmon-strong);
                background: #ffffff;
                box-shadow: 0 0 20px rgba(255, 87, 66, 0.15);
                transform: translateY(-1px);
            }

                .input-group:focus-within .input-group-text {
                    color: var(--accent-salmon-strong);
                }

            .form-group-container:focus-within .form-label {
                color: var(--accent-salmon-strong) !important;
            }

            /* Botão Shimmer */
            .btn-kantine {
                background: linear-gradient(135deg, var(--accent-salmon-strong) 0%, var(--accent-coral-vibrant) 100%);
                color: #ffffff;
                border: none;
                border-radius: 16px;
                padding: 0.95rem;
                font-weight: 700;
                letter-spacing: 0.8px;
                text-transform: uppercase;
                font-size: 0.85rem;
                transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                position: relative;
                overflow: hidden;
                box-shadow: 0 6px 24px rgba(255, 87, 66, 0.35);
            }

                .btn-kantine::after {
                    content: '';
                    position: absolute;
                    top: -50%;
                    left: -60%;
                    width: 30%;
                    height: 200%;
                    background: linear-gradient( to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0) 100% );
                    transform: rotate(25deg);
                    animation: shimmerEffect 4s ease-in-out infinite;
                }

                .btn-kantine:hover {
                    transform: translateY(-3px) scale(1.01);
                    box-shadow: 0 12px 30px rgba(255, 87, 66, 0.5);
                    color: #ffffff;
                }

                .btn-kantine:active {
                    transform: translateY(-1px) scale(0.99);
                }

                .btn-kantine i {
                    transition: transform 0.3s ease;
                }

                .btn-kantine:hover i {
                    transform: translateX(4px);
                }

            .custom-alert {
                background: rgba(239, 68, 68, 0.08);
                border: 1px solid rgba(239, 68, 68, 0.2);
                color: #dc2626;
                font-weight: 500;
                border-radius: 16px;
                animation: shakeAlert 0.4s ease-in-out;
            }

            /* Bloqueia a compilação do Razor duplicando o caractere comercial em formato de texto */
            @@keyframes cardEntrance {
                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@keyframes fadeInScale {
                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            @@keyframes fadeIn {
                to {
                    opacity: 1;
                }
            }

            @@keyframes floatGlow {
                0% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(30px, -20px) scale(1.05);
                }

                100% {
                    transform: translate(-15px, 15px) scale(0.98);
                }
            }

            @@keyframes shimmerEffect {
                0% {
                    left: -60%;
                }

                15% {
                    left: 140%;
                }

                100% {
                    left: 140%;
                }
            }

            @@keyframes shakeAlert {
                0%, 100% {
                    transform: translateX(0);
                }

                20%, 60% {
                    transform: translateX(-6px);
                }

                40%, 80% {
                    transform: translateX(6px);
                }
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="container login-container">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-4">

                <div class="card login-card p-4 p-sm-5 border-0">
                    <div class="card-body p-0">

                        <div class="text-center mb-5">
                            <div class="logo-wrapper mb-3">
                                <img src="~/imagens/logoKant.webp" alt="Kantine Gastronomia" class="logo-img" />
                            </div>
                            <div class="system-subtitle mt-1">
                                Controle de Fichas & Estoque
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert custom-alert py-3 small d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                <div>@ViewBag.Erro</div>
                            </div>
                        }

                        <form asp-controller="Login" asp-action="Autenticar" method="post">

                            <div class="mb-4 form-group-container">
                                <label class="form-label fw-bold">Usuário</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" asp-for="Usuario" class="form-control" placeholder="Digite seu usuário" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Usuario" class="text-danger small d-block mt-1" style="font-size: 0.73rem; padding-left: 4px;"></span>
                            </div>

                            <div class="mb-5 form-group-container">
                                <label class="form-label fw-bold">Senha</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" asp-for="Senha" class="form-control" placeholder="Digite sua senha" />
                                </div>
                                <span asp-validation-for="Senha" class="text-danger small d-block mt-1" style="font-size: 0.73rem; padding-left: 4px;"></span>
                            </div>

                            <button type="submit" class="btn btn-kantine w-100">
                                Entrar no sistema <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>