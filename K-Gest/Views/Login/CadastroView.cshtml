@model K_Gest.Models.CadastroViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastro - Kantine Gastronomia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

        <link rel="stylesheet" href="~/css/k-gest-login.css" />
</head>
<body class="d-flex align-items-center min-vh-100">

    <div class="background-effects">
        <div class="bg-glow-1"></div>
        <div class="bg-glow-2"></div>
    </div>

    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">

                <div class="card login-card p-3 p-sm-4 border-0">
                    <div class="card-body p-0">

                        <div class="text-center mb-3">
                            <div class="logo-wrapper mb-2">
                                <img src="~/imagens/logoKant.webp" alt="Kantine Gastronomia" class="logo-img" />
                            </div>
                            <div class="system-subtitle mt-1">
                                Criar Nova Conta do Sistema
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert custom-alert small d-flex align-items-center mb-2" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2 fs-6"></i>
                                <div>@ViewBag.Erro</div>
                            </div>
                        }

                        <form asp-controller="Login" asp-action="SalvarCadastro" method="post">

                            <div class="mb-2 form-group-container">
                                <label class="form-label fw-bold">Nome Completo</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                    <input type="text" asp-for="NomeExibicao" class="form-control" placeholder="Ex: João da Silva" autocomplete="off" />
                                </div>
                                <span asp-validation-for="NomeExibicao" class="text-danger small d-block" style="font-size: 0.70rem; padding-left: 4px; margin-top: 2px;"></span>
                            </div>

                            <div class="mb-2 form-group-container">
                                <label class="form-label fw-bold">Usuário (Login)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" asp-for="Usuario" class="form-control" placeholder="Escolha um usuário" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Usuario" class="text-danger small d-block" style="font-size: 0.70rem; padding-left: 4px; margin-top: 2px;"></span>
                            </div>

                            <div class="mb-2 form-group-container">
                                <label class="form-label fw-bold">Senha</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" asp-for="Senha" class="form-control" placeholder="Crie uma senha segura" />
                                </div>
                                <span asp-validation-for="Senha" class="text-danger small d-block" style="font-size: 0.70rem; padding-left: 4px; margin-top: 2px;"></span>
                            </div>

                            <div class="mb-3 form-group-container">
                                <label class="form-label fw-bold">Confirmar Senha</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                    <input type="password" asp-for="ConfirmaSenha" class="form-control" placeholder="Digite a senha novamente" />
                                </div>
                                <span asp-validation-for="ConfirmaSenha" class="text-danger small d-block" style="font-size: 0.70rem; padding-left: 4px; margin-top: 2px;"></span>
                            </div>

                            <button type="submit" class="btn btn-kantine w-100 mb-3">
                                Concluir Cadastro <i class="bi bi-check-circle ms-1 fs-6 align-middle"></i>
                            </button>

                            <a asp-controller="Login" asp-action="Index" class="btn-kantine-outline w-100">
                                <i class="bi bi-arrow-left me-2 fs-6"></i> Já tenho conta (Login)
                            </a>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>